		and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(100, 100, 100)
	if batFPS then
		RunService:BindToRenderStep("DemFPS", Enum.RenderPriority.Last.Value, function(dt)
			table.insert(bufferFPS, dt)
			if #bufferFPS > MAU_FPS then table.remove(bufferFPS, 1) end
			if #bufferFPS > 0 then
				local tong = 0
				for _, v in ipairs(bufferFPS) do tong = tong + v end
				local fps = math.round(#bufferFPS / tong)
				nhanFPS.TextColor3 = fps >= 55 and Color3.fromRGB(0, 255, 100)
					or fps >= 30 and Color3.fromRGB(255, 200, 0)
					or Color3.fromRGB(255, 60, 60)
				nhanFPS.Text = string.format("FPS: %d", fps)
			end
		end)
	else
		RunService:UnbindFromRenderStep("DemFPS")
		bufferFPS = {}
		nhanFPS.Text = ""
	end
end)

