local function toggleFly()
	isFlying = not isFlying
	flyButton.Text = isFlying and "🕊️ Bay: BẬT" or "🕊️ Bay: TẮT"
	flyButton.BackgroundColor3 = isFlying
		and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(100, 100, 100)
	local root = getRootPart()
	local hum  = getHumanoid()
	if not root then return end
	if isFlying then
		if isStandingOnAir then
			-- stopStandOnAir inline via toggleStandOnAir later declared
			stopStandOnAir(); isStandingOnAir = false
			standAirButton.Text = "🪩 Thảm kính: TẮT"
			standAirButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		end
		if isFlyWalkMode then
			stopFlyWalkMode() -- forward declared
		end
		flyBodyVelocity = createInstance("BodyVelocity", {
			MaxForce = Vector3.new(4000, 4000, 4000)}, root)
		flyBodyGyro = createInstance("BodyGyro", {
			MaxTorque = Vector3.new(4000, 4000, 4000)}, root)
		if hum then hum.AutoRotate = false; hum.PlatformStand = true end
		if not flyPlatform then
			flyPlatform = createInstance("Part", {
				Name = "FlyPlatform",
				Size = Vector3.new(6, 0.2, 6),
				Transparency = 0.7,
				Color = Color3.fromRGB(255, 255, 255),
				Material = Enum.Material.Glass,
				Anchored = true, CanCollide = false,
			}, workspace)
		end
		RunService:BindToRenderStep("FlyUpdate", 1, function()
			if not isFlying or not root or not flyBodyVelocity then return end
			local moveDir = hum and hum.MoveDirection or Vector3.zero
			local worldMove = root.CFrame:VectorToWorldSpace(moveDir)
			if worldMove.Magnitude > 0 then worldMove = worldMove.Unit end
			local up, down = getVerticalInput()
			local vertical = (up and 1 or 0) - (down and 1 or 0)
			flyBodyVelocity.Velocity = (worldMove + Vector3.new(0, vertical, 0)) * flySpeed
			flyBodyGyro.CFrame = CFrame.new(
				root.Position,
				root.Position + workspace.CurrentCamera.CFrame.LookVector
			)
			if flyPlatform then
				flyPlatform.Position = root.Position - Vector3.new(0, 3.5, 0)
			end
		end)
	else
		stopFly()
	end
	showMobileControls()
end

local function toggleStandOnAir()
	isStandingOnAir = not isStandingOnAir
	standAirButton.Text = isStandingOnAir and "🪩 Thảm kính: BẬT" or "🪩 Thảm kính: TẮT"
