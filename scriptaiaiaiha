local function thucThiMot(code,ten)
	if #ten>0 then print("👤 Chạy bởi:",ten) end
	return pcall(function()
		local fn,err=loadstring(code); if not fn then error(err) end; fn()
	end)
end
local function layThamSo()
	local sl=math.clamp(tonumber(oLap.Text) or 1,1,1000)
	local cho=math.max(tonumber(oCho.Text) or 0,0)
	if nutDonVi.Text=="Phút" then cho=cho*60 end
	return sl,cho
end
local function dungTT()
	daHuy=true
	if luongHT then task.cancel(luongHT); luongHT=nil end
	if chiSoHT then chiSoHT.BackgroundColor3=Color3.fromRGB(0,150,255); chiSoHT=nil end
	nhanTT.Text="⏹️ Đã dừng"
end
local function chayAsync(code,ten,cs)
	dungTT(); if #code==0 then nhanTT.Text="⚠️ Vui lòng nhập code!"; return end
	local sl,cho=layThamSo(); nhanTT.Text="⏳ Đang thực thi..."; daHuy=false
	if cs then chiSoHT=cs; cs.BackgroundColor3=Color3.fromRGB(255,0,0) end
	luongHT=task.spawn(function()
		local ok_c,fl_c=0,0
		for i=1,sl do
			if daHuy then break end
			if i>1 and cho>0 then local da=0; while da<cho do if daHuy then break end; task.wait(0.1); da=da+0.1 end; if daHuy then break end end
			local ok,err=thucThiMot(code,ten)
			if ok then ok_c=ok_c+1 else fl_c=fl_c+1; warn("❌ Lần",i,err) end
			nhanTT.Text=string.format("⏳ %d/%d...",i,sl)
		end
		tongSoLan=tongSoLan+ok_c+fl_c; nhanDem.Text="🔄 Tổng số lần đã chạy: "..tongSoLan
		nhanTT.Text=daHuy and "⏹️ Đã dừng" or (fl_c==0 and string.format("✅ Thành công %d lần!",ok_c) or string.format("⚠️ %d ok, %d lỗi",ok_c,fl_c))
		if cs then cs.BackgroundColor3=Color3.fromRGB(0,150,255); if chiSoHT==cs then chiSoHT=nil end end
		luongHT=nil
	end)
end
nutChay.MouseButton1Click:Connect(function() chayAsync(oCode.Text,oTen.Text,nil) end)

