local QUALITY_PRESETS = {
	Ultra    = {level = 21, shadow = 0.2, diffuse = 1,   specular = 1,   globalShadow = true,  label = "✨ Ultra"},
	High     = {level = 17, shadow = 0.5, diffuse = 1,   specular = 1,   globalShadow = true,  label = "🔵 High"},
	Medium   = {level = 10, shadow = 1,   diffuse = 0.8, specular = 0.6, globalShadow = true,  label = "🟡 Medium"},
	Low      = {level = 5,  shadow = 1,   diffuse = 0.5, specular = 0.3, globalShadow = false, label = "🟢 Low"},
	UltraLow = {level = 1,  shadow = 1,   diffuse = 0,   specular = 0,   globalShadow = false, label = "⚡ UltraLow"},
}

local function applyQualityPreset(key)
	local p = QUALITY_PRESETS[key]
	if not p then return end
	pcall(function() settings().Rendering.QualityLevel = p.level end)
	Lighting.ShadowSoftness              = p.shadow
	Lighting.GlobalShadows               = p.globalShadow
	Lighting.EnvironmentDiffuseScale     = p.diffuse
	Lighting.EnvironmentSpecularScale    = p.specular
	qualityLabel.Text       = "📊 Chất lượng: " .. p.label
	qualityLabel.TextColor3 = (key == "Ultra")
		and Color3.fromRGB(220, 80, 80) or Color3.fromRGB(0, 140, 70)
	-- Cập nhật shadow button
	isShadowOn = p.globalShadow
	shadowToggle.Text = isShadowOn and "🌑 Bóng đổ: BẬT" or "🌑 Bóng đổ: TẮT"
	shadowToggle.BackgroundColor3 = isShadowOn
		and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(100, 100, 100)
end

