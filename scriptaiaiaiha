-- ==================== CUSTOM CAMERA ====================
local ccX,ccY=0,10
local rMouse=false

local function DisCC()
    RunService:UnbindFromRenderStep("CC")
    local cam=workspace.CurrentCamera
    if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end
end

local function EnCC()
    local cam=workspace.CurrentCamera; if not cam then return end
    ccX=0; ccY=10
    cam.CameraType=Enum.CameraType.Scriptable
    cam.FieldOfView=S.fov
    RunService:BindToRenderStep("CC",Enum.RenderPriority.Camera.Value,function()
        if not S.customCam then return end
        local r=Root(); if not r then return end
        local h=char and char:FindFirstChild("Head")
        local bp2=h and h.Position or r.Position
        local cf=CFrame.new(bp2)*CFrame.Angles(0,math.rad(ccX),0)*CFrame.Angles(math.rad(ccY),0,0)
        local off=cf.RightVector*S.camOffX+cf.UpVector*S.camOffY
        local cp2=bp2+cf.LookVector*(-8)+off+Vector3.new(0,1.5,0)
        cam.CFrame=CFrame.new(cp2,bp2+Vector3.new(0,1.5,0))
        cam.FieldOfView=S.fov
    end)
end

local function TogCC()
    if S.freeCam then return end
    S.customCam=not S.customCam
    if S.customCam then EnCC() else DisCC() end
