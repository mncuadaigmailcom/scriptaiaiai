local TEN_CAM_TC = "CamTuyChon"

local function tatCamTuyChon()
	RunService:UnbindFromRenderStep(TEN_CAM_TC)
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
	-- KHÔNG lock chuột ở đây để tránh xung đột
end

local function batCamTuyChonFunc()
	local cam = workspace.CurrentCamera
	if not cam then return end
	gocCamX = 0
	gocCamY = 10
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = fovTuyChon

	RunService:BindToRenderStep(TEN_CAM_TC, Enum.RenderPriority.Camera.Value, function()
		if not batCamTuyChon then return end
		local root = layRootPart()
		if not root then return end

		local dau = nhanVat and nhanVat:FindFirstChild("Head")
		local goc = dau and dau.Position or root.Position

		-- Tính vị trí camera dựa theo góc
		local cf = CFrame.new(goc)
			* CFrame.Angles(0, math.rad(gocCamX), 0)
			* CFrame.Angles(math.rad(gocCamY), 0, 0)

		local lech = cf.RightVector * offsetCamX + cf.UpVector * offsetCamY
		local viTriCam = goc + cf.LookVector * (-8) + lech + Vector3.new(0, 1.5, 0)

		cam.CFrame = CFrame.new(viTriCam, goc + Vector3.new(0, 1.5, 0))
		cam.FieldOfView = fovTuyChon
	end)
end

local function togCamTuyChon()
	-- Không cho bật đồng thời với camera tự do
	if batCamTuDo then return end

	batCamTuyChon = not batCamTuyChon
	nutCamTuyChon.Text = batCamTuyChon
		and "📷 Camera tùy chỉnh: BẬT" or "📷 Camera tùy chỉnh: TẮT"
	nutCamTuyChon.BackgroundColor3 = batCamTuyChon
		and Color3.fromRGB(200,120,50) or Color3.fromRGB(100,100,100)

	if batCamTuyChon then
		batCamTuyChonFunc()
	else
		tatCamTuyChon()
	end
end
