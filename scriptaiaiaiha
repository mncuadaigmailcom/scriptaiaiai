local function setParticles(enabled)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then obj.Enabled=enabled end
    end
end
local function setDecals(enabled)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") then obj.Transparency=enabled and 0 or 1 end
    end
end

partBtn.MouseButton1Click:Connect(function() S.particles=not S.particles; setParticles(S.particles); partBtn.Text=S.particles and "💨 Hạt: BẬT" or "💨 Hạt: TẮT"; partBtn.BackgroundColor3=S.particles and C.GREEN or C.GRAY end)
