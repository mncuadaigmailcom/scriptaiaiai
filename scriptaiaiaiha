-- Sấm sét (visual)
local function createLightning()
	if not isStorming then return end
	local startPos = Vector3.new(
		(character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position or Vector3.new(0,50,0)).X + math.random(-50, 50),
		200,
		(character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position or Vector3.new(0,50,0)).Z + math.random(-50, 50)
	)
	local endPos = startPos + Vector3.new(math.random(-30, 30), -math.random(150, 200), math.random(-30, 30))

	-- Tạo tia chớp từ nhiều part nhỏ
	local bolt = Instance.new("Part")
	bolt.Name = "LightningBolt"
	bolt.Size = Vector3.new(0.3, (startPos - endPos).Magnitude, 0.3)
	bolt.CFrame = CFrame.new((startPos + endPos)/2, endPos)
	bolt.Material = Enum.Material.Neon
	bolt.BrickColor = BrickColor.new("Bright yellow")
	bolt.Anchored = true
	bolt.CanCollide = false
	bolt.Parent = workspace
	table.insert(lightningParts, bolt)
	-- Xóa sau 0.2s
	task.delay(0.2, function()
		if bolt then bolt:Destroy() end
		table.remove(lightningParts, table.find(lightningParts, bolt))
	end)

	-- Chớp sáng
	lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
	task.delay(0.1, function()
		if isStorming then
			lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 100)
		end
	end)
	if stormThunderSound then stormThunderSound:Play() end
end

