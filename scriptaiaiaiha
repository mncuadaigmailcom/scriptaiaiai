local function AddTab(def)
    -- Nút tab nằm trong cột dọc bên phải
    local btn = New("TextButton",{
        Size=UDim2.new(1,0,0,70),
        Text="",
        BackgroundColor3=Color3.fromRGB(238,238,250),
        BackgroundTransparency=0.1,
        BorderSizePixel=0,
        LayoutOrder=def.order,
        AutoButtonColor=false,
    },tabCol)
    Corner(btn,UDim.new(0,8))

    -- Icon lớn
    local iconL = New("TextLabel",{
        Size=UDim2.new(1,0,0,30),
        Position=UDim2.new(0,0,0,6),
        Text=def.icon,
        BackgroundTransparency=1,
        TextColor3=C.DARK,
        Font=Enum.Font.GothamBold,
        TextSize=20,
        TextXAlignment=Enum.TextXAlignment.Center,
    },btn)

    -- Tên tab
    local nameL = New("TextLabel",{
        Size=UDim2.new(1,0,0,28),
        Position=UDim2.new(0,0,0,34),
        Text=def.short,
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(90,90,115),
        Font=Enum.Font.GothamMedium,
        TextSize=9,
        TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Center,
    },btn)

    -- ScrollingFrame cho nội dung tab (trong contentArea bên trái)
    local sf = New("ScrollingFrame",{
        Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1,
        BorderSizePixel=0,
        ScrollBarThickness=4,
        ScrollBarImageColor3=Color3.fromRGB(160,160,185),
        ClipsDescendants=true,
        CanvasSize=UDim2.new(0,0,0,0),
        Visible=false,
    },contentArea)

    local function activate()
        -- Ẩn tất cả tab khác
        for _,t in ipairs(tabContent) do t.Visible=false end
        -- Reset tất cả nút
        for _,b in ipairs(tabs) do
            b.BackgroundColor3=Color3.fromRGB(238,238,250)
            b.BackgroundTransparency=0.1
            -- Reset text colors
            for _,ch in ipairs(b:GetChildren()) do
                if ch:IsA("TextLabel") then
                    if ch.TextSize>=18 then
                        ch.TextColor3=C.DARK
                    else
                        ch.TextColor3=Color3.fromRGB(90,90,115)
                    end
                end
            end
        end
        -- Kích hoạt tab này
        sf.Visible=true
        btn.BackgroundColor3=C.BLUE
        btn.BackgroundTransparency=0.05
        iconL.TextColor3=C.WHITE
        nameL.TextColor3=Color3.fromRGB(200,220,255)
        activeTab=sf
    end

    btn.MouseButton1Click:Connect(function()
        if activeTab==sf then return end
        activate()
    end)
    btn.MouseEnter:Connect(function()
        if activeTab~=sf then Tween(btn,{BackgroundTransparency=0.4},0.15) end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab~=sf then Tween(btn,{BackgroundTransparency=0.1},0.15) end
    end)

    table.insert(tabs,btn)
    table.insert(tabContent,sf)
    return sf, activate
end

