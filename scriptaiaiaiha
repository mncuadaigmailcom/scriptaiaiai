        Text="🎥 Camera Tự Do  |  [F] Thoát  |  Shift = nhanh",
        BackgroundTransparency=1,TextColor3=Color3.fromRGB(0,230,255),
        Font=Enum.Font.GothamBold,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=101,
    },fcHUD2)

