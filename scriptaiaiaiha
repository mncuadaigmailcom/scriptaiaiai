UserInputService.TouchStarted:Connect(function(inp,proc)
	if proc then return end
	local pos=inp.Position
	for _,e in ipairs(bdCamUng) do
		local b,k=e[1],e[2]; local ap,as=b.AbsolutePosition,b.AbsoluteSize
		if pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y then
