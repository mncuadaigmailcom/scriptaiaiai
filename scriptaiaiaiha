        local n=nameIn.Text; local c=codeIn.Text
        if #c==0 then statusL.Text="⚠️ Nhập code trước!"; return end
        if #n==0 then n="Script "..(#scripts+1) end
        local base=n; local cnt=1
        while true do
            local ex=false
            for _,s2 in ipairs(scripts) do if s2.name==n then ex=true; break end end
            if not ex then break end
            cnt=cnt+1; n=base.." ("..cnt..")"
        end
        table.insert(scripts,{name=n,code=c})
        rebuild(); statusL.Text="✅ Đã lưu: "..n
    end)

