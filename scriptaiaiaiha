-- ==================== THỰC THI CODE ====================
local function thucThiMot(code, ten)
	if #ten > 0 then print("👤 Chạy bởi:", ten) end
	return pcall(function()
		local fn, err = loadstring(code)
		if not fn then error(err) end
		fn()
	end)
end

local function layThamSo()
	local soLan = math.clamp(tonumber(oLap.Text) or 1, 1, 1000)
	local cho   = math.max(tonumber(oCho.Text) or 0, 0)
	if nutDonVi.Text == "Phút" then cho = cho * 60 end
	return soLan, cho
end

local function dungThucThi()
	daHuy = true
	if luongHienTai then task.cancel(luongHienTai); luongHienTai = nil end
	if danhSachHienThi then
		danhSachHienThi.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
		danhSachHienThi = nil
	end
	nhanTrangThai.Text = "⏹️ Đã dừng"
end

local function chayCodeAsync(code, ten, chiSo)
	dungThucThi()
	if #code == 0 then nhanTrangThai.Text = "⚠️ Vui lòng nhập code!"; return end
	local soLan, giaycho = layThamSo()
	nhanTrangThai.Text = "⏳ Đang thực thi..."
	daHuy = false
	if chiSo then
		danhSachHienThi = chiSo
		chiSo.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
	luongHienTai = task.spawn(function()
		local ok_c, fail_c = 0, 0
		for i = 1, soLan do
			if daHuy then break end
			if i > 1 and giaycho > 0 then
				local da = 0
				while da < giaycho do
					if daHuy then break end
					task.wait(0.1); da += 0.1
				end
				if daHuy then break end
			end
			local ok, err = thucThiMot(code, ten)
			if ok then ok_c += 1 else fail_c += 1; warn("❌ Lần", i, err) end
			nhanTrangThai.Text = string.format("⏳ %d/%d đang chạy...", i, soLan)
		end
		tongSoLan += ok_c + fail_c
		nhanDemSoLan.Text  = "🔄 Tổng số lần đã chạy: " .. tongSoLan
		nhanTrangThai.Text = daHuy and "⏹️ Đã dừng"
			or (fail_c == 0
				and string.format("✅ Thành công %d lần!", ok_c)
				or  string.format("⚠️ %d thành công, %d thất bại", ok_c, fail_c))
		if chiSo then
			chiSo.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
			if danhSachHienThi == chiSo then danhSachHienThi = nil end
		end
		luongHienTai = nil
	end)
end

