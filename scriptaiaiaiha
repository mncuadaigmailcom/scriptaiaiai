-- ==================== QUẢN LÝ THỰC THI CODE ====================
local function executeOnce(code, name)
	if #name>0 then print("👤", name) end
	local ok, res = pcall(function()
		local fn, err = (loadstring or function(c) return loadstring(c) end)(code)
		if not fn then error(err) end
		fn()
	end)
	return ok, res
end

local function getExecutionParams()
	local loopCount = tonumber(loopBox.Text) or 1
	if loopCount <= 0 or loopCount > 1000 then loopCount = 1 end
	local delayStr = delayBox.Text
	local unit = unitButton.Text
	local delay = tonumber(delayStr) or 0
	if delay < 0 then delay = 0 end
	if unit == "Phút" then delay = delay * 60 end
	return loopCount, delay
end

local function stopExecution()
	executionCancelled = true
	if currentThread then
		task.cancel(currentThread)
		currentThread = nil
	end
	if currentIndicator then
		currentIndicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
		currentIndicator = nil
	end
	statusLabel.Text = "⏹️ Đã dừng"
end

local function runCodeAsync(code, name, indicator)
	stopExecution() -- Dừng thread cũ trước khi chạy mới
	if #code == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end
	local loopCount, delaySeconds = getExecutionParams()
	statusLabel.Text = "⏳ Đang thực thi..."
	executionCancelled = false

	if indicator then
		currentIndicator = indicator
		indicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- đỏ
	end

	currentThread = task.spawn(function()
		local okC, failC = 0, 0
		for i = 1, loopCount do
			if executionCancelled then break end
			if i > 1 and delaySeconds > 0 then
				local waited = 0
				while waited < delaySeconds do
					if executionCancelled then break end
					task.wait(0.1)
					waited = waited + 0.1
				end
				if executionCancelled then break end
			end
			if executionCancelled then break end
			local ok, err = executeOnce(code, name)
			if ok then okC = okC + 1 else failC = failC + 1; warn("Lần", i, err) end
			statusLabel.Text = string.format("⏳ %d/%d...", i, loopCount)
		end
		totalExecutions += (okC + failC)
		countLabel.Text = "🔄 Tổng số lần đã chạy: " .. totalExecutions
		if executionCancelled then
			statusLabel.Text = "⏹️ Đã dừng"
		else
			statusLabel.Text = failC == 0 and string.format("✅ %d lần thành công!", loopCount) or string.format("⚠️ %d ok, %d fail", okC, failC)
		end
		if indicator then
			indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255) -- xanh
			if currentIndicator == indicator then
				currentIndicator = nil
			end
		end
		currentThread = nil
	end)
end

-- Nút chạy code chính
