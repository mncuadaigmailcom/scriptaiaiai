        BackgroundColor3 = Color3.fromRGB(245, 245, 245),
        BackgroundTransparency = 0.3,
        TextColor3 = Color3.fromRGB(30, 30, 30),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Parent = parent or scrollFrame
    })
    if multiline then
        box.MultiLine = true
        box.TextWrapped = true
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.TextYAlignment = Enum.TextYAlignment.Top
    end
    addCorner(box, 5)
    addStroke(box, Color3.fromRGB(140, 140, 140), 1.2)
    return box
end

local function createButton(text, y, w, h, accentColor, parent)
    local btn = createInstance("TextButton", {
        Size = UDim2.new(0, w, 0, h),
        Position = UDim2.new(0.5, -w/2, 0, y),
        Text = text,
        BackgroundColor3 = accentColor or Color3.fromRGB(0, 160, 100),
        BackgroundTransparency = 0.2,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        BorderSizePixel = 0,
        Parent = parent or scrollFrame
    })
    addCorner(btn, 6)
    addStroke(btn, accentColor and accentColor:Lerp(Color3.new(0,0,0), 0.4) or Color3.fromRGB(0, 100, 70), 1.2)
    
    btn.MouseEnter:Connect(function()
        tweenProperty(btn, {BackgroundColor3 = (accentColor or Color3.fromRGB(0, 160, 100)):Lerp(Color3.new(1,1,1), 0.3)})
    end)
    btn.MouseLeave:Connect(function()
        tweenProperty(btn, {BackgroundColor3 = accentColor or Color3.fromRGB(0, 160, 100)})
    end)
    return btn
end

