    local function doCancel()
        cancelled2=true
        if curT2 then task.cancel(curT2); curT2=nil end
        if curI2 then curI2.BackgroundColor3=C.GREEN; curI2=nil end
        statusL.Text="⏹️ Đã dừng"
    end

    local function doRun(code,name,ind,times,delay)
        doCancel()
        if #code==0 then statusL.Text="⚠️ Nhập code trước!"; return end
        cancelled2=false
        if ind then curI2=ind; ind.BackgroundColor3=C.RED end
        local ok2,fail2=0,0
        curT2=task.spawn(function()
            for i=1,times do
                if cancelled2 then break end
                if i>1 and delay>0 then
                    local e=0
                    while e<delay and not cancelled2 do task.wait(0.1); e=e+0.1 end
                    if cancelled2 then break end
                end
                local ok,er=pcall(function()
                    if #name>0 then print("▶",name) end
                    local fn,e2=loadstring(code)
                    if not fn then error(e2) end; fn()
                end)
                if ok then ok2=ok2+1 else fail2=fail2+1; warn("❌",i,er) end
            end
            totalRuns2=totalRuns2+ok2+fail2
            if ind and curI2==ind then ind.BackgroundColor3=C.GREEN; curI2=nil end
            curT2=nil
            if not cancelled2 then statusL.Text="✅ Xong! OK:"..ok2.." Lỗi:"..fail2 end
            countL.Text="🔄 Tổng: "..totalRuns2.." lần chạy"
        end)
    end

