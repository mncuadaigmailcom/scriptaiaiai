-- ==================== HÀM RESET TẤT CẢ TÍNH NĂNG (RESET ALL) ====================
local function ResetAllFeatures()
    -- 1. Di chuyển
    if S.flying then S.flying = false; StopFly() end
    if S.carpet then StopCarpet(); S.carpet = false end
    if S.flyRun then StopFlyRun() end
    if S.noClip then S.noClip = false; DisNC() end
    S.infJump = false
    S.clickTp = false
    S.walkSpeed = 16
    S.jumpPower = 50
    S.flySpeed = 50
    UpdCarpetSize(1.5)
    UpdChar()

    -- Reset UI Di Chuyển
    flyBtn.Text = "🕊️ Bay: TẮT"; flyBtn.BackgroundColor3 = C.GRAY
    carpBtn.Text = "🪩 Thảm kính: TẮT"; carpBtn.BackgroundColor3 = C.GRAY
    flyRunBtn.Text = "🕹️ Bay chạy bộ: TẮT"; flyRunBtn.BackgroundColor3 = C.GRAY
    noclipBtn.Text = "🚶 NoClip: TẮT"; noclipBtn.BackgroundColor3 = C.GRAY
    infJumpBtn.Text = "🦘 Nhảy Vô Hạn: TẮT"; infJumpBtn.BackgroundColor3 = C.GRAY
    clickTpBtn.Text = "🎯 Click TP (Ctrl+Click): TẮT"; clickTpBtn.BackgroundColor3 = C.GRAY
    wsIn.Text = "16"; jpIn.Text = "50"; flySpdIn.Text = "50"

    -- 2. Người chơi
    if S.esp then S.esp = false; ClearAllESP() end
    S.antiAfk = true
    espBtn.Text = "👁️ ESP Người Chơi: TẮT"; espBtn.BackgroundColor3 = C.GRAY
    antiAfkBtn.Text = "🛡️ Anti-AFK (Treo máy): BẬT"; antiAfkBtn.BackgroundColor3 = C.GREEN

    -- 3. Môi trường
    S.fog = false; S.fullBright = false
    TweenL(DEFAULT_LIGHTING)
    fogBtn.Text = "🌫️ Sương mù: TẮT"; fogBtn.BackgroundColor3 = C.GRAY
    fullBrightBtn.Text = "💡 Sáng Đêm: TẮT"; fullBrightBtn.BackgroundColor3 = C.GRAY
    brightIn.Text = "1.2"; aR.Text = "128"; aG.Text = "128"; aB.Text = "128"

    -- 4. Camera
    if S.customCam then S.customCam = false; DisCC() end
    if S.freeCam then S.freeCam = false; DisFC() end
    S.fov = 70; S.camOffX = 0; S.camOffY = 0; S.freeCamSpeed = 30
    ccBtn.Text = "📷 Camera tùy chỉnh: TẮT"; ccBtn.BackgroundColor3 = C.GRAY
    fcBtn.Text = "🎥 Camera tự do: TẮT"; fcBtn.BackgroundColor3 = C.GRAY
    fovIn.Text = "70"; offXIn.Text = "0"; offYIn.Text = "0"; fcSpdIn.Text = "30"

    -- 5. Đồ họa
    S.shadows = true; S.bloom = true; S.blur = false; S.sunRays = true; S.colorCorr = false
    be.Enabled = true; ble.Enabled = false; sre.Enabled = true; cce.Enabled = false
    S.particles = true; S.decals = true
    setParticles(true); setDecals(true)
    shadowBtn.Text = "🌑 Bóng đổ: BẬT"; shadowBtn.BackgroundColor3 = C.GREEN
    if S.fpsCounter then
        S.fpsCounter = false
        RunService:UnbindFromRenderStep("FPS")
        fpsLbl.Visible = false
        fpsBtn.Text = "📈 Hiện FPS: TẮT"
        fpsBtn.BackgroundColor3 = C.GRAY
    end
    qualLbl.Text = "Chất lượng: Tự động"

    print("🔄 Đã Reset Tất Cả Tính Năng Về Mặc Định!")
end

