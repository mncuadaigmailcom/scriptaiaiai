-- ============ HELPER ============
local function New(cls, props, parent)
    local o = Instance.new(cls)
    for k,v in pairs(props or {}) do o[k]=v end
    if parent then o.Parent=parent end
    return o
end
local function Corner(p,r) New("UICorner",{CornerRadius=r or UDim.new(0,7)},p) end
local function Stroke(p,c,t) New("UIStroke",{Color=c or Color3.fromRGB(180,180,195),Thickness=t or 1.2},p) end
local function TwnL(props) TweenService:Create(Lighting,TweenInfo.new(1.5,Enum.EasingStyle.Quad),props):Play() end
local function Twn(obj,props,d)
    TweenService:Create(obj,TweenInfo.new(d or 0.18,Enum.EasingStyle.Quad),props):Play()
end

