end)

local function showMobileControls()
	mobileControlsFrame.Visible = isFlying and UserInputService.TouchEnabled
end

function stopFly()
	if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
	if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
	if character and character:FindFirstChild("Humanoid") then
		character.Humanoid.AutoRotate = true
		character.Humanoid.PlatformStand = false
	end
	RunService:UnbindFromRenderStep("FlyUpdate")
	showMobileControls()
end

function stopStandOnAir()
	if standBodyPosition then standBodyPosition:Destroy() standBodyPosition = nil end
	if character and character:FindFirstChild("Humanoid") then
		character.Humanoid.PlatformStand = false
	end
	RunService:UnbindFromRenderStep("StandUpdate")
end

-- Bay
local function toggleFly()
	isFlying = not isFlying
	flyButton.Text = isFlying and "🕊️ Bay: BẬT" or "🕊️ Bay: TẮT"
	flyButton.BackgroundColor3 = isFlying and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(100, 100, 100)
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local root = character.HumanoidRootPart
	local hum = character.Humanoid

	if isFlying then
		if isStandingOnAir then toggleStandOnAir() end
		flyBodyVelocity = Instance.new("BodyVelocity")
		flyBodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
		flyBodyVelocity.Parent = root
		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(4000, 4000, 4000)
		flyBodyGyro.Parent = root
		hum.AutoRotate = false
		hum.PlatformStand = true

		RunService:BindToRenderStep("FlyUpdate", 1, function()
			if not isFlying or not root or not flyBodyVelocity then return end
			local moveDir = hum.MoveDirection
			local worldMove = root.CFrame:VectorToWorldSpace(moveDir)
			if worldMove.Magnitude > 0 then worldMove = worldMove.Unit end
			local up, down = getVerticalInput()
			local vertical = (up and 1 or 0) - (down and 1 or 0)
			flyBodyVelocity.Velocity = (worldMove + Vector3.new(0, vertical, 0)) * flySpeed
			flyBodyGyro.CFrame = CFrame.new(root.Position, root.Position + workspace.CurrentCamera.CFrame.LookVector)
		end)
	else
		stopFly()
	end
	showMobileControls()
end

-- Đứng trên không (tốc độ game)
local function toggleStandOnAir()
	isStandingOnAir = not isStandingOnAir
	standAirButton.Text = isStandingOnAir and "🧍 Đứng trên không: BẬT" or "🧍 Đứng trên không: TẮT"
	standAirButton.BackgroundColor3 = isStandingOnAir and Color3.fromRGB(160, 100, 200) or Color3.fromRGB(100, 100, 100)
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local root = character.HumanoidRootPart
	local hum = character.Humanoid

	if isStandingOnAir then
		if isFlying then toggleFly() end
		standBodyPosition = Instance.new("BodyPosition")
		standBodyPosition.MaxForce = Vector3.new(100000, 100000, 100000)
		standBodyPosition.Parent = root
		hum.PlatformStand = true
		local targetY = root.Position.Y
		local speed = hum.WalkSpeed  -- tốc độ mặc định của game

		RunService:BindToRenderStep("StandUpdate", 1, function()
			if not isStandingOnAir or not root or not standBodyPosition then return end
			local moveDir = hum.MoveDirection
			local worldMove = root.CFrame:VectorToWorldSpace(moveDir)
			if worldMove.Magnitude > 0 then worldMove = worldMove.Unit end
			local newPos = root.Position + worldMove * speed * 0.016
			newPos = Vector3.new(newPos.X, targetY, newPos.Z)
			standBodyPosition.Position = newPos
		end)
	else
		stopStandOnAir()
	end
end

