-- ==================== HÀM TIỆN ÍCH ====================
local function safeNumber(str, default, min, max)
    local n = tonumber(str)
    if not n then return default end
    if min and n < min then n = min end
    if max and n > max then n = max end
    return n
end

local function applyCharacterSpeed()
    if not References.character or not References.character:FindFirstChild("Humanoid") then return end
    local hum = References.character.Humanoid
