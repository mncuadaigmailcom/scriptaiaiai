	RunService:UnbindFromRenderStep("CapNhatTham"); yThamKinh=nil
end
local function taoTham(yOff)
	local root=getRoot(); if not root then return end
	nenTham=newObj("Part",{Name="ThamKinhPhep",Size=Vector3.new(kichThuocTham,0.5,kichThuocTham),Transparency=0.7,Color=Color3.fromRGB(200,230,255),Material=Enum.Material.Glass,Anchored=true,CanCollide=true,Position=Vector3.new(root.Position.X,yOff,root.Position.Z)},workspace)
	bpTham=newObj("BodyPosition",{MaxForce=Vector3.new(0,50000,0),P=5000,D=500,Position=Vector3.new(root.Position.X,yOff+3,root.Position.Z)},root)
	yThamKinh=yOff
	RunService:BindToRenderStep("CapNhatTham",1,function()
		if not dangThamKinh or not nenTham or not root or not bpTham then return end
		local x,z=root.Position.X,root.Position.Z
		nenTham.Position=Vector3.new(x,yThamKinh,z)
		bpTham.Position=Vector3.new(x,yThamKinh+3,z)
	end)
end
local dungBayChayBoFn
local function togBay()
	dangBay=not dangBay
	nutBay.Text=dangBay and "🕊️ Bay: BẬT" or "🕊️ Bay: TẮT"
	nutBay.BackgroundColor3=dangBay and Color3.fromRGB(70,130,180) or Color3.fromRGB(100,100,100)
	local root=getRoot(); local hum=getHum(); if not root then return end
	if dangBay then
		if dangThamKinh then dungThamFn(); dangThamKinh=false; nutThamKinh.Text="🪩 Thảm kính: TẮT"; nutThamKinh.BackgroundColor3=Color3.fromRGB(100,100,100) end
		if dangBayChayBo and dungBayChayBoFn then dungBayChayBoFn() end
		bvBay=newObj("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},root)
		bgBay=newObj("BodyGyro",{MaxTorque=Vector3.new(4000,4000,4000)},root)
		if hum then hum.AutoRotate=false; hum.PlatformStand=true end
		if not nenBay then nenBay=newObj("Part",{Name="NenBay",Size=Vector3.new(6,0.2,6),Transparency=0.7,Color=Color3.fromRGB(200,230,255),Material=Enum.Material.Glass,Anchored=true,CanCollide=false},workspace) end
		RunService:BindToRenderStep("CapNhatBay",1,function()
			if not dangBay or not root or not bvBay then return end
			local md=hum and hum.MoveDirection or Vector3.zero
			local dich=root.CFrame:VectorToWorldSpace(md)
			if dich.Magnitude>0 then dich=dich.Unit end
			local u,d=getVertical()
			bvBay.Velocity=(dich+Vector3.new(0,(u and 1 or 0)-(d and 1 or 0),0))*tocDoBay
			bgBay.CFrame=CFrame.new(root.Position,root.Position+workspace.CurrentCamera.CFrame.LookVector)
			if nenBay then nenBay.Position=root.Position-Vector3.new(0,3.5,0) end
		end)
	else dungBayFn() end
	showMobile()
end
local function togTham()
	dangThamKinh=not dangThamKinh
