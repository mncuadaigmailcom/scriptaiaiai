	nutBay.Text="🕊️ Bay: TẮT"; nutBay.BackgroundColor3=Color3.fromRGB(100,100,100)
	nutThamKinh.Text="🪩 Thảm kính: TẮT"; nutThamKinh.BackgroundColor3=Color3.fromRGB(100,100,100)
	nutBayChayBo.Text="🕹️ Bay chạy bộ: TẮT"; nutBayChayBo.BackgroundColor3=Color3.fromRGB(100,100,100)
