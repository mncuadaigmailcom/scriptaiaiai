-- ==================== UI HELPERS ====================
local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function addCorner(parent, radius)
    return create("UICorner", {CornerRadius = radius or UDim.new(0, 6)}, parent)
end

local function addStroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or Color3.fromRGB(140, 140, 140),
        Thickness = thickness or 1.2
    }, parent)
end

local function tween(obj, props, duration, easingStyle)
    duration = duration or 1.5
    easingStyle = easingStyle or Enum.EasingStyle.Quad
    TweenService:Create(obj, TweenInfo.new(duration, easingStyle), props):Play()
end

local function tweenLighting(props)
    tween(Lighting, props)
end

