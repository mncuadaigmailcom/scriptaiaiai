local function dungBayFn()
	if bvBay then bvBay:Destroy(); bvBay=nil end
	if bgBay then bgBay:Destroy(); bgBay=nil end
	if nenBay then nenBay:Destroy(); nenBay=nil end
	local hum=getHum(); if hum then hum.AutoRotate=true; hum.PlatformStand=false end
	RunService:UnbindFromRenderStep("CapNhatBay"); showMobile()
end
local function dungThamFn()
	if nenTham then nenTham:Destroy(); nenTham=nil end
