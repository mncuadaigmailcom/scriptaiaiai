nutFPS.MouseButton1Click:Connect(function()
	batFPS           = not batFPS
	nhanFPS.Visible  = batFPS
	nutFPS.Text      = batFPS and "📈 Hiện FPS: BẬT" or "📈 Hiện FPS: TẮT"
