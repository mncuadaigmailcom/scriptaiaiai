-- ==================== THỰC THI CODE ====================
local function executeOnce(code, name)
	if #name>0 then print("👤", name) end
	local ok, res = pcall(function()
		local fn, err = (loadstring or function(c) return loadstring(c) end)(code)
		if not fn then error(err) end
		fn()
	end)
	return ok, res
end
local function getExecutionParams()
	local loopCount = tonumber(loopBox.Text) or 1
	if loopCount <= 0 or loopCount > 1000 then loopCount = 1 end
	local delay = tonumber(delayBox.Text) or 0
	if delay < 0 then delay = 0 end
	if unitButton.Text == "Phút" then delay = delay * 60 end
	return loopCount, delay
end
local function stopExecution()
	executionCancelled = true
	if currentThread then task.cancel(currentThread); currentThread = nil end
	if currentIndicator then currentIndicator.BackgroundColor3 = Color3.fromRGB(0,150,255); currentIndicator = nil end
	statusLabel.Text = "⏹️ Đã dừng"
end
local function runCodeAsync(code, name, indicator)
	stopExecution()
	if #code == 0 then statusLabel.Text = "⚠️ Vui lòng nhập code!"; return end
	local loopCount, delaySeconds = getExecutionParams()
	statusLabel.Text = "⏳ Đang thực thi..."
	executionCancelled = false
	if indicator then currentIndicator = indicator; indicator.BackgroundColor3 = Color3.fromRGB(255,0,0) end
	currentThread = task.spawn(function()
		local okC, failC = 0, 0
		for i = 1, loopCount do
			if executionCancelled then break end
			if i > 1 and delaySeconds > 0 then
				local waited = 0
				while waited < delaySeconds do if executionCancelled then break end; task.wait(0.1); waited += 0.1 end
				if executionCancelled then break end
			end
			if executionCancelled then break end
			local ok, err = executeOnce(code, name)
			if ok then okC += 1 else failC += 1; warn("Lần", i, err) end
			statusLabel.Text = string.format("⏳ %d/%d...", i, loopCount)
		end
		totalExecutions += (okC + failC)
		countLabel.Text = "🔄 Tổng số lần: " .. totalExecutions
		statusLabel.Text = executionCancelled and "⏹️ Đã dừng" or (failC == 0 and string.format("✅ %d lần thành công!", loopCount) or string.format("⚠️ %d ok, %d fail", okC, failC))
		if indicator then indicator.BackgroundColor3 = Color3.fromRGB(0,150,255); if currentIndicator == indicator then currentIndicator = nil end end
		currentThread = nil
	end)
end
runButton.MouseButton1Click:Connect(function() runCodeAsync(codeBox.Text, nameBox.Text, nil) end)

-- Quản lý script
local function updateCanvas()
	local count = #savedScripts
	scrollFrame.CanvasSize = UDim2.new(0,0,0, math.max(yPos + 30 + count*32, 520))
end
local function clearList()
	for _, v in ipairs(scriptListFrame:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
end
local function rebuildList()
	clearList()
	for i, data in ipairs(savedScripts) do
		local row = Instance.new("Frame") row.Size = UDim2.new(1,0,0,28) row.BackgroundColor3 = Color3.fromRGB(255,255,255) row.BackgroundTransparency = 0.4 row.BorderSizePixel = 0 row.Parent = scriptListFrame
		Instance.new("UICorner", row).CornerRadius = UDim.new(0,6)
		Instance.new("UIStroke", row).Color = Color3.fromRGB(180,180,180) Instance.new("UIStroke", row).Thickness = 1
		local btn = Instance.new("TextButton") btn.Size = UDim2.new(1,-50,1,0) btn.Text = data.name btn.BackgroundTransparency = 1 btn.TextColor3 = Color3.fromRGB(30,30,30) btn.Font = Enum.Font.GothamMedium btn.TextSize = 12 btn.TextXAlignment = Enum.TextXAlignment.Left btn.Parent = row
		local indicator = Instance.new("TextButton") indicator.Size = UDim2.new(0,16,0,16) indicator.Position = UDim2.new(1,-42,0.5,-8) indicator.Text = "" indicator.BackgroundColor3 = Color3.fromRGB(0,150,255) indicator.BorderSizePixel = 0 indicator.Parent = row
		Instance.new("UICorner", indicator).CornerRadius = UDim.new(1,0)
		indicator.MouseButton1Click:Connect(function() if currentIndicator == indicator then stopExecution() end end)
		local del = Instance.new("TextButton") del.Size = UDim2.new(0,22,0,22) del.Position = UDim2.new(1,-24,0.5,-11) del.Text = "✕" del.BackgroundColor3 = Color3.fromRGB(200,60,60) del.BackgroundTransparency = 0.2 del.TextColor3 = Color3.fromRGB(255,255,255) del.Font = Enum.Font.GothamBold del.TextSize = 13 del.BorderSizePixel = 0 del.Parent = row
		Instance.new("UICorner", del).CornerRadius = UDim.new(1,0)
		btn.MouseButton1Click:Connect(function() nameBox.Text = data.name; codeBox.Text = data.code; runCodeAsync(data.code, data.name, indicator) end)
		del.MouseButton1Click:Connect(function()
			if currentIndicator == indicator then stopExecution() end
			table.remove(savedScripts, i)
			rebuildList()
			updateCanvas()
		end)
	end
	updateCanvas()
end
saveButton.MouseButton1Click:Connect(function()
	local n, c = nameBox.Text, codeBox.Text
	if #c == 0 then statusLabel.Text = "⚠️ Vui lòng nhập code!"; return end
	if #n == 0 then n = "Script " .. (#savedScripts + 1) end
	local base, counter = n, 1
	while true do
		local dup = false
		for _, s in ipairs(savedScripts) do if s.name == n then dup = true break end end
		if not dup then break end
		counter += 1
		n = base .. " (" .. counter .. ")"
	end
	table.insert(savedScripts, {name = n, code = c})
	rebuildList()
	statusLabel.Text = "✅ Đã lưu: " .. n
	scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

