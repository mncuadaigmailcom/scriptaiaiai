end)

local function VInput()
    return UserInputService:IsKeyDown(Enum.KeyCode.Space) or mInput.up,
           UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mInput.down
end

local bv, bg, fp, cp
local StopFlyRun, TogFlyRun

local function StopFly()
    if bv then bv:Destroy(); bv=nil end
    if bg then bg:Destroy(); bg=nil end
    if fp then fp:Destroy(); fp=nil end
    local h = Hum()
    if h then h.AutoRotate=true; h.PlatformStand=false end
    RunService:UnbindFromRenderStep("Fly")
    mobile.Visible=false
end

local function StopCarpet()
    if cp then cp:Destroy(); cp=nil end
    RunService:UnbindFromRenderStep("Carpet")
    S.carpetY=nil
end

local function CreateCarpet(y)
    local r = Root()
    if not r then return end
    
    if cp then cp:Destroy() end

    local sz = S.carpetSize or 1.5
    S.carpetY = y or (r.Position.Y - 3.1)

    cp = New("Part", {
        Name="Carpet", 
        Size=Vector3.new(sz, 0.2, sz),
        Transparency=0.9,
        Color=Color3.fromRGB(200,230,255), 
        Material=Enum.Material.SmoothPlastic,
        Anchored=true, 
        CanCollide=true, 
        Friction=1,
        Position=Vector3.new(r.Position.X, S.carpetY, r.Position.Z),
    }, workspace)

    -- Cập nhật CFrame và Kích thước thảm trực tiếp trên thời gian thực
    RunService:BindToRenderStep("Carpet", Enum.RenderPriority.Camera.Value - 1, function()
        if not S.carpet or not cp or not r then return end
        local curSz = S.carpetSize or 1.5
        if cp.Size.X ~= curSz or cp.Size.Z ~= curSz then
            cp.Size = Vector3.new(curSz, 0.2, curSz)
        end
        cp.CFrame = CFrame.new(r.Position.X, S.carpetY, r.Position.Z)
    end)
end

local function TogFly()
    local r=Root()
    local h=Hum()
    if not r then return end

    if S.flying then
        if S.carpet then StopCarpet(); S.carpet=false end
        if S.flyRun and StopFlyRun then StopFlyRun() end
        bv=New("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},r)
        bg=New("BodyGyro",{MaxTorque=Vector3.new(4000,4000,4000)},r)
        if h then h.AutoRotate=false; h.PlatformStand=true end
        if not fp then
            fp=New("Part",{
                Name="Floor", Size=Vector3.new(6,0.2,6), Transparency=0.7,
                Color=Color3.fromRGB(200,230,255), Material=Enum.Material.Glass,
                Anchored=true, CanCollide=false,
            }, workspace)
        end
        RunService:BindToRenderStep("Fly",1,function()
            if not S.flying or not r or not bv then return end
            local d=h and h.MoveDirection or Vector3.zero
            local t=r.CFrame:VectorToWorldSpace(d)
            if t.Magnitude>0 then t=t.Unit end
            local u,dn=VInput()
            local vv=(u and 1 or 0)-(dn and 1 or 0)
            bv.Velocity=(t+Vector3.new(0,vv,0))*S.flySpeed
            bg.CFrame=CFrame.new(r.Position,r.Position+workspace.CurrentCamera.CFrame.LookVector)
            fp.Position=r.Position-Vector3.new(0,3.5,0)
        end)
    else
        StopFly()
    end
    mobile.Visible=S.flying and UserInputService.TouchEnabled
end

local function TogCarpet()
    local r=Root()
    if not r then return end
    if S.carpet then
        if S.flying then S.flying=false; StopFly() end
        CreateCarpet(r.Position.Y - 3.1)
    else
        StopCarpet()
    end
end

