local btnFlyUp   = createMobileBtn("⏫", UDim2.new(0, 8, 0, 8))
local btnFlyDown = createMobileBtn("⏬", UDim2.new(0, 134, 0, 8))

local mobileKeys    = {FlyUp = false, FlyDown = false}
local activeTouches = {}

local touchMap = {{btnFlyUp, "FlyUp"}, {btnFlyDown, "FlyDown"}}
UserInputService.TouchStarted:Connect(function(input, processed)
	if processed then return end
	local pos = input.Position
	for _, entry in ipairs(touchMap) do
		local btn, key = entry[1], entry[2]
		local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
		if pos.X >= ap.X and pos.X <= ap.X + as.X
			and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
			mobileKeys[key] = true
			activeTouches[input] = key
			break
		end
	end
end)
UserInputService.TouchEnded:Connect(function(input)
	if activeTouches[input] then
		mobileKeys[activeTouches[input]] = false
		activeTouches[input] = nil
	end
end)

local function getVerticalInput()
	return UserInputService:IsKeyDown(Enum.KeyCode.Space) or mobileKeys.FlyUp,
		   UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mobileKeys.FlyDown
end

local function showMobileControls()
	mobileControlsFrame.Visible = isFlying and UserInputService.TouchEnabled
end

local function stopFly()
	if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
	if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
	if flyPlatform then flyPlatform:Destroy(); flyPlatform = nil end
	local hum = getHumanoid()
	if hum then hum.AutoRotate = true; hum.PlatformStand = false end
	RunService:UnbindFromRenderStep("FlyUpdate")
	showMobileControls()
end

local function stopStandOnAir()
	if standPlatform then standPlatform:Destroy(); standPlatform = nil end
	if standBodyPosition then standBodyPosition:Destroy(); standBodyPosition = nil end
	RunService:UnbindFromRenderStep("CarpetUpdate")
	carpetTargetY = nil
end

