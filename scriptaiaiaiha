local function AddTab(name, icon, order)
    local btn = New("TextButton", {
        Size=UDim2.new(1,-4,0,32), Position=UDim2.new(0,2,0,0),
        Text=icon.."\n"..name, BackgroundColor3=C.BG, BackgroundTransparency=0.2,
        TextColor3=Color3.fromRGB(180,180,180), Font=Enum.Font.GothamBold, TextSize=8,
        BorderSizePixel=0, LayoutOrder=order,
    }, tabBar)
    Corner(btn, UDim.new(0,4))
    
    local sf = New("ScrollingFrame", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=3, ScrollBarImageColor3=Color3.fromRGB(60,60,60),
        ClipsDescendants=true, CanvasSize=UDim2.new(0,0,0,0), Visible=false,
    }, contentArea)
    
    btn.MouseButton1Click:Connect(function()
        if currentTab==sf then return end
        for _, t in ipairs(tabPages) do t.Visible=false end
        for _, b in ipairs(tabBtns) do b.BackgroundColor3=C.BG; b.BackgroundTransparency=0.2; b.TextColor3=Color3.fromRGB(180,180,180) end
        sf.Visible=true
        btn.BackgroundColor3=C.ACCENT
        btn.BackgroundTransparency=0.1
        btn.TextColor3=C.WHITE
        currentTab=sf
    end)
    
    table.insert(tabBtns, btn)
    table.insert(tabPages, sf)
    return sf
end

