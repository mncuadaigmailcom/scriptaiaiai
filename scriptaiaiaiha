		else
			fovBox.Text = tostring(customFov)
		end
	end
end)

camOffsetXBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local num = tonumber(camOffsetXBox.Text)
		if num then
			customOffsetX = num
		else
			camOffsetXBox.Text = tostring(customOffsetX)
		end
	end
end)

camOffsetYBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local num = tonumber(camOffsetYBox.Text)
		if num then
			customOffsetY = num
		else
			camOffsetYBox.Text = tostring(customOffsetY)
		end
	end
end)

-- Sự kiện chuột cho camera tùy chỉnh
UserInputService.InputChanged:Connect(function(input)
	if not isCustomCamera then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta
		camAngleX = (camAngleX - delta.X * 0.1) % 360
		camAngleY = math.clamp(camAngleY - delta.Y * 0.1, -80, 80)
	end
end)

-- Character handling
player.CharacterAdded:Connect(function(char)
	character = char
	if char:FindFirstChild("Humanoid") then applyCharacterSpeed() end
	if isFlying then stopFly() isFlying = false end
	if isStandingOnAir then stopStandOnAir() isStandingOnAir = false end
	if isNoClipOn then enableNoClip() end
	if isFlyWalkMode then stopFlyWalkMode() end
	-- Nếu camera tùy chỉnh đang bật, khởi động lại
	if isCustomCamera then
		stopCustomCamera()
		startCustomCamera()
	end
	flyButton.Text = "🕊️ Bay: TẮT"
	flyButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	standAirButton.Text = "🪩 Thảm kính: TẮT"
	standAirButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	flyWalkButton.Text = "🕹️ Bay chạy bộ: TẮT"
	flyWalkButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	flyWalkOverlay.Visible = false
	mobileControlsFrame.Visible = false
end)

