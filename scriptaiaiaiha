local upBtn = MBtn("⏫", UDim2.new(0,8,0,8))
local dnBtn = MBtn("⏬", UDim2.new(0,120,0,8))
local mInput = {up=false, down=false}
local tMap = {}

UserInputService.TouchStarted:Connect(function(i, p)
    if p then return end
    local pos = i.Position
    for _, d in ipairs({{upBtn,"up"},{dnBtn,"down"}}) do
        local b, k = d[1], d[2]
        local ap = b.AbsolutePosition; local as = b.AbsoluteSize
        if pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y then
            mInput[k]=true; tMap[i]=k; break
        end
    end
end)
UserInputService.TouchEnded:Connect(function(i) if tMap[i] then mInput[tMap[i]]=false; tMap[i]=nil end end)

local function VInput()
    return UserInputService:IsKeyDown(Enum.KeyCode.Space) or mInput.up,
           UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mInput.down
end

local bv, bg, fp, cp, bp

local function StopFly()
    if bv then bv:Destroy(); bv=nil end
    if bg then bg:Destroy(); bg=nil end
    if fp then fp:Destroy(); fp=nil end
    local h = Hum()
    if h then h.AutoRotate=true; h.PlatformStand=false end
    RunService:UnbindFromRenderStep("Fly")
    mobile.Visible=false
end

local function StopCarpet()
    if cp then cp:Destroy(); cp=nil end
    if bp then bp:Destroy(); bp=nil end
    RunService:UnbindFromRenderStep("Carpet")
    S.carpetY=nil
end

local function CreateCarpet(y)
    local r = Root(); if not r then return end
    cp = New("Part", {Name="Carpet", Size=Vector3.new(S.carpetSize,0.5,S.carpetSize), Transparency=0.7, Color=Color3.fromRGB(200,230,255), Material=Enum.Material.Glass, Anchored=true, CanCollide=true, Position=Vector3.new(r.Position.X,y,r.Position.Z)}, workspace)
    bp = New("BodyPosition", {MaxForce=Vector3.new(0,50000,0), P=5000, D=500, Position=Vector3.new(r.Position.X,y+3,r.Position.Z)}, r)
    S.carpetY=y
    RunService:BindToRenderStep("Carpet", 1, function()
        if not S.carpet or not cp or not r or not bp then return end
        local x, z = r.Position.X, r.Position.Z
        cp.Position=Vector3.new(x,S.carpetY,z); bp.Position=Vector3.new(x,S.carpetY+3,z)
    end)
end

local function TogFly()
    S.flying=not S.flying
    local r=Root(); local h=Hum(); if not r then return end
    if S.flying then
        if S.carpet then StopCarpet(); S.carpet=false end
        if S.flyRun then StopFlyRun(); S.flyRun=false end
        bv=New("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},r)
        bg=New("BodyGyro",{MaxTorque=Vector3.new(4000,4000,4000)},r)
        if h then h.AutoRotate=false; h.PlatformStand=true end
        if not fp then fp=New("Part",{Name="Floor",Size=Vector3.new(6,0.2,6),Transparency=0.7,Color=Color3.fromRGB(200,230,255),Material=Enum.Material.Glass,Anchored=true,CanCollide=false},workspace) end
        RunService:BindToRenderStep("Fly",1,function()
            if not S.flying or not r or not bv then return end
            local d=h and h.MoveDirection or Vector3.zero
            local t=r.CFrame:VectorToWorldSpace(d)
            if t.Magnitude>0 then t=t.Unit end
            local u,dn=VInput(); local vv=(u and 1 or 0)-(dn and 1 or 0)
            bv.Velocity=(t+Vector3.new(0,vv,0))*S.flySpeed
            bg.CFrame=CFrame.new(r.Position,r.Position+workspace.CurrentCamera.CFrame.LookVector)
            fp.Position=r.Position-Vector3.new(0,3.5,0)
        end)
    else StopFly() end
    mobile.Visible=S.flying and UserInputService.TouchEnabled
end

local function TogCarpet()
    S.carpet=not S.carpet
    local r=Root(); if not r then return end
    if S.carpet then if S.flying then TogFly() end; CreateCarpet(r.Position.Y-3.5) else StopCarpet() end
end

