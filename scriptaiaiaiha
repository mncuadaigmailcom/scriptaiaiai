local function taoThamKinh(yOffset)
	local root = layRootPart()
	if not root then return end
	nenTham = newObj("Part", {
		Name = "ThamKinhPhep",
		Size = Vector3.new(kichThuocTham, 0.5, kichThuocTham),
		Transparency = 0.7,
		Color = Color3.fromRGB(200, 230, 255),
		Material = Enum.Material.Glass,
		Anchored = true,
		CanCollide = true,
		Position = Vector3.new(root.Position.X, yOffset, root.Position.Z),
	}, workspace)
	bodyPosTham = newObj("BodyPosition", {
		MaxForce = Vector3.new(0, 50000, 0),
		P = 5000, D = 500,
		Position = Vector3.new(root.Position.X, yOffset + 3, root.Position.Z),
	}, root)
	yThamKinh = yOffset
	RunService:BindToRenderStep("CapNhatTham", 1, function()
		if not dangThamKinh or not nenTham or not root or not bodyPosTham then return end
		local x, z = root.Position.X, root.Position.Z
		nenTham.Position     = Vector3.new(x, yThamKinh, z)
		bodyPosTham.Position = Vector3.new(x, yThamKinh + 3, z)
	end)
end

local dungBayChayBoFunc -- khai báo trước

local function togBay()
	dangBay = not dangBay
	nutBay.Text = dangBay and "🕊️ Bay: BẬT" or "🕊️ Bay: TẮT"
	nutBay.BackgroundColor3 = dangBay
		and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(100, 100, 100)
	local root = layRootPart()
	local hum  = layHumanoid()
	if not root then return end
	if dangBay then
		if dangThamKinh then
			dungThamKinh(); dangThamKinh = false
			nutThamKinh.Text = "🪩 Thảm kính: TẮT"
			nutThamKinh.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		end
		if dangBayChayBo and dungBayChayBoFunc then dungBayChayBoFunc() end
		bodyVelocityBay = newObj("BodyVelocity", {MaxForce = Vector3.new(4000,4000,4000)}, root)
		bodyGyroBay     = newObj("BodyGyro", {MaxTorque = Vector3.new(4000,4000,4000)}, root)
		if hum then hum.AutoRotate = false; hum.PlatformStand = true end
		if not nenBay then
			nenBay = newObj("Part", {
				Name = "NenBay",
				Size = Vector3.new(6, 0.2, 6),
				Transparency = 0.7,
				Color = Color3.fromRGB(200, 230, 255),
				Material = Enum.Material.Glass,
				Anchored = true, CanCollide = false,
			}, workspace)
		end
		RunService:BindToRenderStep("CapNhatBay", 1, function()
			if not dangBay or not root or not bodyVelocityBay then return end
			local huong = hum and hum.MoveDirection or Vector3.zero
			local dich  = root.CFrame:VectorToWorldSpace(huong)
			if dich.Magnitude > 0 then dich = dich.Unit end
			local len, xuong = layNhapDocThan()
			local doc = (len and 1 or 0) - (xuong and 1 or 0)
			bodyVelocityBay.Velocity = (dich + Vector3.new(0, doc, 0)) * tocDoBay
			bodyGyroBay.CFrame = CFrame.new(root.Position,
				root.Position + workspace.CurrentCamera.CFrame.LookVector)
			if nenBay then nenBay.Position = root.Position - Vector3.new(0, 3.5, 0) end
		end)
	else
		dungBay()
	end
	hienDieuKhienMobile()
end

local function togThamKinh()
	dangThamKinh = not dangThamKinh
	nutThamKinh.Text = dangThamKinh and "🪩 Thảm kính: BẬT" or "🪩 Thảm kính: TẮT"
