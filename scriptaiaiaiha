		Position = Vector3.new(root.Position.X, yOffset, root.Position.Z),
	}, workspace)
	bodyPosTham = newObj("BodyPosition", {
		MaxForce = Vector3.new(0,50000,0),
		P = 5000, D = 500,
		Position = Vector3.new(root.Position.X, yOffset+3, root.Position.Z),
	}, root)
	yThamKinh = yOffset
	RunService:BindToRenderStep("CapNhatTham", 1, function()
		if not dangThamKinh or not nenTham or not root or not bodyPosTham then return end
		local x, z = root.Position.X, root.Position.Z
		nenTham.Position     = Vector3.new(x, yThamKinh, z)
		bodyPosTham.Position = Vector3.new(x, yThamKinh+3, z)
	end)
