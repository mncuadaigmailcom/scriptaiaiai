end)

-- ==================== QUẢN LÝ DANH SÁCH SCRIPT ====================
local function updateCanvas()
	local count = #savedScripts
	local height = yPos + 30 + count * 32
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(height, 550))
end

local function clearList()
	for _, v in ipairs(scriptListFrame:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end
end

local function rebuildList()
	clearList()
	for i, data in ipairs(savedScripts) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 28)
		row.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
		row.BackgroundTransparency = 0.3
		row.BorderSizePixel = 0
		row.Parent = scriptListFrame
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)
		local rowStroke = Instance.new("UIStroke", row)
		rowStroke.Color = Color3.fromRGB(140, 140, 140)
		rowStroke.Thickness = 1

		-- Nút tên script
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -50, 1, 0) -- chừa chỗ cho đèn và nút xóa
		btn.Text = data.name
		btn.BackgroundTransparency = 1
		btn.TextColor3 = Color3.fromRGB(50, 50, 50)
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 12
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = row

		-- Đèn chỉ thị (ô vuông xanh)
		local indicator = Instance.new("TextButton")
		indicator.Size = UDim2.new(0, 16, 0, 16)
		indicator.Position = UDim2.new(1, -44, 0.5, -8)
		indicator.Text = ""
		indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
		indicator.BorderSizePixel = 0
		indicator.Parent = row
		Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)
		-- Sự kiện dừng nếu đang chạy
		indicator.MouseButton1Click:Connect(function()
			if currentIndicator == indicator then
				stopExecution()
			end
		end)

		-- Nút xóa
		local del = Instance.new("TextButton")
		del.Size = UDim2.new(0, 22, 0, 22)
		del.Position = UDim2.new(1, -24, 0.5, -11)
		del.Text = "✕"
		del.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
		del.BackgroundTransparency = 0.2
		del.TextColor3 = Color3.fromRGB(255, 255, 255)
		del.Font = Enum.Font.GothamBold
		del.TextSize = 13
		del.BorderSizePixel = 0
		del.Parent = row
		Instance.new("UICorner", del).CornerRadius = UDim.new(1, 0)

		-- Sự kiện chạy script khi nhấn vào tên
		btn.MouseButton1Click:Connect(function()
			nameBox.Text = data.name
			codeBox.Text = data.code
			runCodeAsync(data.code, data.name, indicator)
		end)

		del.MouseButton1Click:Connect(function()
			-- Nếu script đang chạy và bị xóa thì dừng trước
			if currentIndicator == indicator then
				stopExecution()
			end
			table.remove(savedScripts, i)
			rebuildList()
			updateCanvas()
		end)
	end
	updateCanvas()
end

saveButton.MouseButton1Click:Connect(function()
	local n, c = nameBox.Text, codeBox.Text
	if #c == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end
	if #n == 0 then n = "Script " .. (#savedScripts + 1) end
	local base, counter = n, 1
	while true do
		local dup = false
		for _, s in ipairs(savedScripts) do
			if s.name == n then dup = true break end
		end
		if not dup then break end
		counter += 1
		n = base .. " (" .. counter .. ")"
	end
	table.insert(savedScripts, { name = n, code = c })
	rebuildList()
	statusLabel.Text = "✅ Đã lưu: " .. n
	scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

