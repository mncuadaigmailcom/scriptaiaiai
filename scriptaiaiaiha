-- ==================== HÀM TIỆN ÍCH ====================
local function applyProps(obj, props)
	for k, v in pairs(props) do obj[k] = v end
	return obj
end

local function addCorner(parent, radius)
	return applyProps(Instance.new("UICorner", parent), {CornerRadius = radius or UDim.new(0, 6)})
end

local function addStroke(parent, color, thickness)
	return applyProps(Instance.new("UIStroke", parent), {
		Color = color or Color3.fromRGB(140, 140, 140),
		Thickness = thickness or 1.2
	})
end

local function tween(obj, info, props)
	TweenService:Create(obj, info, props):Play()
end

local function tweenLight(props)
	tween(Lighting, TweenInfo.new(1.5, Enum.EasingStyle.Quad), props)
end

local function newObj(className, props, parent)
	local obj = Instance.new(className)
	if props then applyProps(obj, props) end
	if parent then obj.Parent = parent end
	return obj
end

