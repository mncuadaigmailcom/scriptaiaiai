local function updateCanvas()
	local count = #savedScripts
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0,
		math.max(yPos + 30 + count * 30, 500))
end

local function rebuildList()
	for _, v in ipairs(scriptListFrame:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end
	for i, data in ipairs(savedScripts) do
		local row = createInstance("Frame", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = Color3.fromRGB(245, 245, 245),
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
		}, scriptListFrame)
		addCorner(row, UDim.new(0, 5))
		addStroke(row, Color3.fromRGB(140, 140, 140), 1)

		local btn = createInstance("TextButton", {
			Size = UDim2.new(1, -46, 1, 0),
			Text = data.name,
			BackgroundTransparency = 1,
			TextColor3 = Color3.fromRGB(50, 50, 50),
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)

		local indicator = createInstance("TextButton", {
			Size = UDim2.new(0, 14, 0, 14),
			Position = UDim2.new(1, -40, 0.5, -7),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(0, 150, 255),
			BorderSizePixel = 0,
		}, row)
		addCorner(indicator, UDim.new(1, 0))

		local del = createInstance("TextButton", {
			Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(1, -22, 0.5, -10),
			Text = "✕",
			BackgroundColor3 = Color3.fromRGB(200, 60, 60),
			BackgroundTransparency = 0.2,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			BorderSizePixel = 0,
		}, row)
		addCorner(del, UDim.new(1, 0))

		local idx = i -- capture
		indicator.MouseButton1Click:Connect(function()
			if currentIndicator == indicator then stopExecution() end
		end)
		btn.MouseButton1Click:Connect(function()
			nameBox.Text = data.name
			codeBox.Text = data.code
			runCodeAsync(data.code, data.name, indicator)
		end)
		del.MouseButton1Click:Connect(function()
			if currentIndicator == indicator then stopExecution() end
			table.remove(savedScripts, idx)
			rebuildList(); updateCanvas()
		end)
	end
	updateCanvas()
end

saveButton.MouseButton1Click:Connect(function()
	local n, c = nameBox.Text, codeBox.Text
	if #c == 0 then statusLabel.Text = "⚠️ Vui lòng nhập code!"; return end
	if #n == 0 then n = "Script " .. (#savedScripts + 1) end
	local base, counter = n, 1
	while true do
		local dup = false
		for _, s in ipairs(savedScripts) do
			if s.name == n then dup = true; break end
		end
		if not dup then break end
		counter += 1; n = base .. " (" .. counter .. ")"
	end
	table.insert(savedScripts, {name = n, code = c})
	rebuildList()
	statusLabel.Text = "✅ Đã lưu: " .. n
	scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

