local TEN_CAM = "CameraTuyChon"

local function batCamera()
	local cam = workspace.CurrentCamera
	if not cam then return end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = fovTuyChon
	gocCamX, gocCamY = 0, 0
	UserInputService.MouseBehavior    = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	RunService:BindToRenderStep(TEN_CAM, Enum.RenderPriority.Camera.Value, function()
		if not batCamera or not nhanVat then return end
		local root = layRootPart()
		if not root then return end
		local dau    = nhanVat:FindFirstChild("Head")
		local viTriNen = (dau and dau.Position or root.Position) + Vector3.new(0, 2, 0)
		local huongNhin = (
			CFrame.Angles(0, math.rad(gocCamX), 0)
			* CFrame.Angles(math.rad(gocCamY), 0, 0)
		).LookVector
		local lech = root.CFrame.RightVector * offsetCamX + Vector3.new(0, offsetCamY, 0)
		cam.CFrame = CFrame.new(viTriNen + lech - huongNhin * 5, viTriNen + huongNhin * 10)
	end)
end

local function tatCamera()
	RunService:UnbindFromRenderStep(TEN_CAM)
	local cam = workspace.CurrentCamera
	if cam then cam.CameraType = Enum.CameraType.Custom; cam.FieldOfView = 70 end
	UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function togCamera()
	batCamera = not batCamera
	nutCamera.Text = batCamera and "📷 Camera: BẬT" or "📷 Camera: TẮT"
	nutCamera.BackgroundColor3 = batCamera
		and Color3.fromRGB(200, 120, 50) or Color3.fromRGB(100, 100, 100)
	if batCamera then batCamera() else tatCamera() end
end
nutCamera.MouseButton1Click:Connect(togCamera)

UserInputService.InputChanged:Connect(function(input)
	if not batCamera then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		gocCamX = (gocCamX - input.Delta.X * 0.1) % 360
		gocCamY = math.clamp(gocCamY - input.Delta.Y * 0.1, -80, 80)
	end
end)

