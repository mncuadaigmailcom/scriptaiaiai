local mobileKeys = {FlyUp = false, FlyDown = false}
local activeTouches = {}
local function onTouchStarted(input, processed)
	if processed then return end
	for _, btnData in ipairs({{btnFlyUp, "FlyUp"}, {btnFlyDown, "FlyDown"}}) do
		local btn, key = btnData[1], btnData[2]
		local pos = input.Position
		local absPos = btn.AbsolutePosition
		local absSize = btn.AbsoluteSize
		if pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y then
			mobileKeys[key] = true; activeTouches[input] = key; break
		end
	end
end
local function onTouchEnded(input)
	if activeTouches[input] then mobileKeys[activeTouches[input]] = false; activeTouches[input] = nil end
end
