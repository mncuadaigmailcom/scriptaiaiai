-- ==================== CODE EXECUTION ====================
local function executeOnce(code, name)
    if #name > 0 then print("👤 Chạy bởi:", name) end
    return pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)
end

local function cancelExecution()
    isCancelled = true
    if currentThread then task.cancel(currentThread); currentThread = nil end
    if currentScriptIndicator then
        currentScriptIndicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        currentScriptIndicator = nil
    end
end

local function runCode(code, name, indicator, times, delay)
    cancelExecution()
    
    if #code == 0 then return false, "⚠️ Vui lòng nhập code!" end
    
    isCancelled = false
    if indicator then
        currentScriptIndicator = indicator
        indicator.BackgroundColor3 = COLOR.RED
    end
    
    local okCount = 0
    local failCount = 0
    
    currentThread = task.spawn(function()
        for i = 1, times do
            if isCancelled then break end
            
            if i > 1 and delay > 0 then
                local elapsed = 0
                while elapsed < delay do
                    if isCancelled then break end
                    task.wait(0.1)
                    elapsed += 0.1
                end
                if isCancelled then break end
            end
            
            local ok, err = executeOnce(code, name)
            if ok then
                okCount += 1
            else
                failCount += 1
                warn("❌ Lần", i, err)
            end
        end
        
        totalRuns += okCount + failCount
        
        if indicator then
            indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            if currentScriptIndicator == indicator then
                currentScriptIndicator = nil
            end
        end
        
        currentThread = nil
    end)
    
    return true, nil
end

