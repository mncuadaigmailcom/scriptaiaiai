-- ==================== EXECUTE CODE ====================
local function executeOnce(code, name)
    if #name > 0 then print("👤", name) end
    local ok, res = pcall(function()
        local fn = loadstring(code)
        if not fn then error("Không thể compile code") end
        fn()
    end)
    return ok, res
end

local function getExecutionParams()
    local loopCount = math.clamp(safeNumber(loopBox.Text, 1, 1, CONFIG.MAX_LOOP), 1, CONFIG.MAX_LOOP)
    local delay = math.max(safeNumber(delayBox.Text, 0, 0) or 0, 0)
    if unitButton.Text == "Phút" then delay = delay * 60 end
    return loopCount, delay
end

local function stopExecution()
    State.isExecuting = false
    if References.currentThread then
        task.cancel(References.currentThread)
        References.currentThread = nil
    end
    if References.currentIndicator then
        References.currentIndicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        References.currentIndicator = nil
    end
    statusLabel.Text = "⏹️ Đã dừng"
end

local function runCodeAsync(code, name, indicator)
    stopExecution()
    if #code == 0 then
        statusLabel.Text = "⚠️ Vui lòng nhập code!"
        return
    end
    
    local loopCount, delaySeconds = getExecutionParams()
    statusLabel.Text = "⏳ Đang thực thi..."
    State.isExecuting = true
    
    if indicator then
        References.currentIndicator = indicator
        indicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end
    
    References.currentThread = task.spawn(function()
        local successCount, failCount = 0, 0
        
        for i = 1, loopCount do
            if not State.isExecuting then break end
            
            if i > 1 and delaySeconds > 0 then
                local waited = 0
                while waited < delaySeconds and State.isExecuting do
                    task.wait(0.1)
                    waited += 0.1
                end
                if not State.isExecuting then break end
            end
            
            local ok, err = executeOnce(code, name)
            if ok then
                successCount += 1
            else
                failCount += 1
                warn("Lần", i, err)
            end
            statusLabel.Text = string.format("⏳ %d/%d...", i, loopCount)
        end
        
        State.totalExecutions += (successCount + failCount)
        countLabel.Text = "🔄 Tổng số lần đã chạy: " .. State.totalExecutions
        
        if not State.isExecuting then
            statusLabel.Text = "⏹️ Đã dừng"
        elseif failCount == 0 then
            statusLabel.Text = string.format("✅ %d lần thành công!", loopCount)
        else
            statusLabel.Text = string.format("⚠️ %d ok, %d fail", successCount, failCount)
        end
        
        if indicator then
            indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            if References.currentIndicator == indicator then
                References.currentIndicator = nil
            end
        end
        References.currentThread = nil
    end)
end

