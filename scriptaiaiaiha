-- ==================== CUSTOM CAMERA ====================
local customCamX = 0
local customCamY = 10
local rightMouseHeld = false

local function disableCustomCamera()
    RunService:UnbindFromRenderStep("CustomCam")
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        cam.FieldOfView = 70
    end
end

local function enableCustomCamera()
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    customCamX = 0
    customCamY = 10
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = state.fov
    
    RunService:BindToRenderStep("CustomCam", Enum.RenderPriority.Camera.Value, function()
        if not state.customCamera then return end
        
        local root = getRootPart()
        if not root then return end
        
        local head = character and character:FindFirstChild("Head")
        local basePos = head and head.Position or root.Position
        
        local cf = CFrame.new(basePos) *
                  CFrame.Angles(0, math.rad(customCamX), 0) *
                  CFrame.Angles(math.rad(customCamY), 0, 0)
        
        local offset = cf.RightVector * state.camOffsetX + cf.UpVector * state.camOffsetY
        local camPos = basePos + cf.LookVector * (-8) + offset + Vector3.new(0, 1.5, 0)
        
        cam.CFrame = CFrame.new(camPos, basePos + Vector3.new(0, 1.5, 0))
        cam.FieldOfView = state.fov
    end)
end

local function toggleCustomCamera()
    if state.freeCam then return end
    
    state.customCamera = not state.customCamera
    
    if state.customCamera then
        enableCustomCamera()
    else
        disableCustomCamera()
    end
end

UserInputService.InputChanged:Connect(function(input)
    if state.customCamera and rightMouseHeld then
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            customCamX = (customCamX - input.Delta.X * 0.35) % 360
            customCamY = math.clamp(customCamY - input.Delta.Y * 0.35, -75, 75)
        end
    end
end)

