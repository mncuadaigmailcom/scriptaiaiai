-- ==================== THỰC THI CODE ====================
local function executeOnce(code, name)
	if #name > 0 then print("👤", name) end
	return pcall(function()
		local fn, err = loadstring(code)
		if not fn then error(err) end
		fn()
	end)
end

local function getExecutionParams()
	local loopCount = math.clamp(tonumber(loopBox.Text) or 1, 1, 1000)
	local delay     = math.max(tonumber(delayBox.Text) or 0, 0)
	if unitButton.Text == "Phút" then delay = delay * 60 end
	return loopCount, delay
end

local function stopExecution()
	executionCancelled = true
	if currentThread then task.cancel(currentThread); currentThread = nil end
	if currentIndicator then
		currentIndicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
		currentIndicator = nil
	end
	statusLabel.Text = "⏹️ Đã dừng"
end

local function runCodeAsync(code, name, indicator)
	stopExecution()
	if #code == 0 then statusLabel.Text = "⚠️ Vui lòng nhập code!"; return end
	local loopCount, delaySeconds = getExecutionParams()
	statusLabel.Text = "⏳ Đang thực thi..."
	executionCancelled = false
	if indicator then
		currentIndicator = indicator
		indicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
	currentThread = task.spawn(function()
		local okC, failC = 0, 0
		for i = 1, loopCount do
			if executionCancelled then break end
			if i > 1 and delaySeconds > 0 then
				local waited = 0
				while waited < delaySeconds do
					if executionCancelled then break end
					task.wait(0.1); waited += 0.1
				end
				if executionCancelled then break end
			end
			local ok, err = executeOnce(code, name)
			if ok then okC += 1 else failC += 1; warn("Lần", i, err) end
			statusLabel.Text = string.format("⏳ %d/%d...", i, loopCount)
		end
		totalExecutions += okC + failC
		countLabel.Text  = "🔄 Tổng số lần đã chạy: " .. totalExecutions
		statusLabel.Text = executionCancelled and "⏹️ Đã dừng"
			or (failC == 0
				and string.format("✅ %d lần thành công!", okC)
				or  string.format("⚠️ %d ok, %d fail", okC, failC))
		if indicator then
			indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
			if currentIndicator == indicator then currentIndicator = nil end
		end
		currentThread = nil
	end)
end

runButton.MouseButton1Click:Connect(function()
