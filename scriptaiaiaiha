local function disableFreeCamera()
    RunService:UnbindFromRenderStep("FreeCam")
    
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        cam.FieldOfView = 70
    end
    
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    
    local root = getRootPart()
    if root then root.Anchored = false end
    
    local hum = getHumanoid()
    if hum then
        hum.AutoRotate = true
        hum.WalkSpeed = state.walkSpeed
        hum.JumpPower = state.jumpPower
    end
    
    freeCamHUD.Visible = false
    crosshair.Visible = false
end

local function enableFreeCamera()
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local root = getRootPart()
    local hum = getHumanoid()
    
    if root then
        freeCamPos = root.Position + Vector3.new(0, 5, 0)
        root.Anchored = true
    end
    
    if hum then
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end
    
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = 90
    freeCamYaw = 0
    freeCamPitch = 0
    
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false
    
    freeCamHUD.Visible = true
    crosshair.Visible = true
    
    RunService:BindToRenderStep("FreeCam", Enum.RenderPriority.Camera.Value, function(dt)
        if not state.freeCam then return end
        
        local delta = UserInputService:GetMouseDelta()
        freeCamYaw = (freeCamYaw - delta.X * 0.3) % 360
        freeCamPitch = math.clamp(freeCamPitch - delta.Y * 0.3, -89, 89)
        
        local cf = CFrame.new(freeCamPos) *
                  CFrame.Angles(0, math.rad(freeCamYaw), 0) *
                  CFrame.Angles(math.rad(freeCamPitch), 0, 0)
        
        local speed = state.freeCamSpeed * dt
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            speed = speed * 3
        end
        
        local move = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.new(0, 1, 0) end
        
        freeCamPos += move * speed
        cam.CFrame = CFrame.new(freeCamPos) *
                     CFrame.Angles(0, math.rad(freeCamYaw), 0) *
                     CFrame.Angles(math.rad(freeCamPitch), 0, 0)
    end)
end

local function toggleFreeCamera()
    if state.customCamera then
        state.customCamera = false
        disableCustomCamera()
    end
    
    state.freeCam = not state.freeCam
    
    if state.freeCam then
        enableFreeCamera()
    else
        disableFreeCamera()
    end
end

