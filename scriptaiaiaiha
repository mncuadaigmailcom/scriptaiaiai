UserInputService.TouchStarted:Connect(function(input, processed)
	if processed then return end
	local pos = input.Position
	for _, entry in ipairs(banDoCamUng) do
		local nut, key = entry[1], entry[2]
		local ap, as = nut.AbsolutePosition, nut.AbsoluteSize
		if pos.X >= ap.X and pos.X <= ap.X + as.X
			and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
			phimMobile[key] = true
			camUng[input] = key
			break
		end
	end
end)
UserInputService.TouchEnded:Connect(function(input)
	if camUng[input] then
		phimMobile[camUng[input]] = false
		camUng[input] = nil
	end
end)

