-- ==================== HÀM TẠO UI ====================
local function taoNhan(text, y)
	return newObj("TextLabel", {
		Size = UDim2.new(1, -16, 0, 14),
		Position = UDim2.new(0, 8, 0, y),
		Text = text,
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(60, 60, 60),
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, khungCuon)
end

local function taoONhap(placeholder, y, height, nhieudong)
	local box = newObj("TextBox", {
		Size = UDim2.new(1, -16, 0, height),
		Position = UDim2.new(0, 8, 0, y),
		PlaceholderText = placeholder,
		PlaceholderColor3 = Color3.fromRGB(160, 160, 160),
		Text = "",
		BackgroundColor3 = Color3.fromRGB(245, 245, 245),
		BackgroundTransparency = 0.3,
		TextColor3 = Color3.fromRGB(30, 30, 30),
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
	}, khungCuon)
	if nhieudong then
		box.MultiLine = true
		box.TextWrapped = true
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
	end
	addCorner(box, UDim.new(0, 5))
	addStroke(box, Color3.fromRGB(140, 140, 140), 1.2)
	return box
end

local function taoNut(text, y, w, h, mauSac)
	local mau = mauSac or Color3.fromRGB(0, 160, 100)
	local nut = newObj("TextButton", {
		Size = UDim2.new(0, w, 0, h),
		Position = UDim2.new(0.5, -w / 2, 0, y),
		Text = text,
		BackgroundColor3 = mau,
		BackgroundTransparency = 0.2,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		BorderSizePixel = 0,
	}, khungCuon)
	addCorner(nut, UDim.new(0, 6))
	addStroke(nut, mau:Lerp(Color3.new(0,0,0), 0.4), 1.2)
	local mauHover = mau:Lerp(Color3.new(1,1,1), 0.3)
	local tw = TweenInfo.new(0.2)
	nut.MouseEnter:Connect(function() tween(nut, tw, {BackgroundColor3 = mauHover}) end)
	nut.MouseLeave:Connect(function() tween(nut, tw, {BackgroundColor3 = mau}) end)
	return nut
end

