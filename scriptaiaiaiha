    walkSpeedLabel.Text = "Hiện tại: " .. CONFIG.WALK_SPEED
    jumpPowerLabel.Text = "Hiện tại: " .. CONFIG.JUMP_POWER
end

-- ==================== NOCLIP ====================
local function enableNoClip()
    RunService:BindToRenderStep("NoClip", 1, function()
        if not State.isNoClip or not References.character then return end
        for _, part in ipairs(References.character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

local function disableNoClip()
    RunService:UnbindFromRenderStep("NoClip")
    if References.character then
        for _, part in ipairs(References.character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function toggleNoClip()
    State.isNoClip = not State.isNoClip
    noClipButton.Text = State.isNoClip and "🚶‍♂️ NoClip: BẬT" or "🚶‍♂️ NoClip: TẮT"
    noClipButton.BackgroundColor3 = State.isNoClip and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(100, 100, 100)
    if State.isNoClip then enableNoClip() else disableNoClip() end
end

-- ==================== FLY ====================
local function showMobileControls()
    mobileControlsFrame.Visible = State.isFlying and UserInputService.TouchEnabled
end

local function stopFly()
    if References.flyBodyVelocity then References.flyBodyVelocity:Destroy(); References.flyBodyVelocity = nil end
    if References.flyBodyGyro then References.flyBodyGyro:Destroy(); References.flyBodyGyro = nil end
    if References.flyPlatform then References.flyPlatform:Destroy(); References.flyPlatform = nil end
    
    if References.character and References.character:FindFirstChild("Humanoid") then
        References.character.Humanoid.AutoRotate = true
        References.character.Humanoid.PlatformStand = false
    end
    RunService:UnbindFromRenderStep("FlyUpdate")
    showMobileControls()
end

local function toggleFly()
    State.isFlying = not State.isFlying
    flyButton.Text = State.isFlying and "🕊️ Bay: BẬT" or "🕊️ Bay: TẮT"
    flyButton.BackgroundColor3 = State.isFlying and Color3.fromRGB(70, 130, 180) or Color3.fromRGB(100, 100, 100)
    
    if not References.character or not References.character:FindFirstChild("HumanoidRootPart") then return end
    local root = References.character.HumanoidRootPart
    local hum = References.character.Humanoid
    
    if State.isFlying then
        if State.isStandingOnAir then toggleStandOnAir() end
        if State.isFlyWalkMode then toggleFlyWalkMode() end
        
        References.flyBodyVelocity = createInstance("BodyVelocity", {
            MaxForce = Vector3.new(4000, 4000, 4000),
            Parent = root
        })
        References.flyBodyGyro = createInstance("BodyGyro", {
            MaxForce = Vector3.new(4000, 4000, 4000),
            Parent = root
        })
        hum.AutoRotate = false
        hum.PlatformStand = true
        
        if not References.flyPlatform then
            References.flyPlatform = createInstance("Part", {
                Name = "FlyPlatform",
                Size = Vector3.new(6, 0.2, 6),
                Transparency = 0.7,
                Color = Color3.fromRGB(255, 255, 255),
                Material = Enum.Material.Glass,
                Anchored = true,
                CanCollide = false,
                Parent = workspace
            })
        end
        
        RunService:BindToRenderStep("FlyUpdate", 1, function()
            if not State.isFlying or not root or not References.flyBodyVelocity then return end
            local moveDir = hum.MoveDirection
            local worldMove = root.CFrame:VectorToWorldSpace(moveDir)
            if worldMove.Magnitude > 0 then worldMove = worldMove.Unit end
            
            local up = UserInputService:IsKeyDown(Enum.KeyCode.Space) or References.mobileKeys.FlyUp
            local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or References.mobileKeys.FlyDown
            local vertical = (up and 1 or 0) - (down and 1 or 0)
            
            References.flyBodyVelocity.Velocity = (worldMove + Vector3.new(0, vertical, 0)) * CONFIG.FLY_SPEED
            References.flyBodyGyro.CFrame = CFrame.new(root.Position, root.Position + workspace.CurrentCamera.CFrame.LookVector)
            
            if References.flyPlatform then
