        BackgroundTransparency=1,TextColor3=Color3.fromRGB(35,75,125),
        Font=Enum.Font.GothamMedium,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,ZIndex=13,
    },infoF)
    y=y+64

    T.CanvasSize=UDim2.new(0,0,0,y+10)

    -- ====== CAMERA LOGIC ======
    local ccX2,ccY2=0,10
    local rMouse2=false

    local function DisCC2()
        RunService:UnbindFromRenderStep("CC2")
        local cam=workspace.CurrentCamera
        if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end
    end
    local function EnCC2()
        local cam=workspace.CurrentCamera; if not cam then return end
        ccX2=0; ccY2=10
        cam.CameraType=Enum.CameraType.Scriptable; cam.FieldOfView=S.fov
        RunService:BindToRenderStep("CC2",Enum.RenderPriority.Camera.Value,function()
            if not S.customCam then return end
            local r=Root(); if not r then return end
            local hd=char and char:FindFirstChild("Head")
            local bp3=hd and hd.Position or r.Position
            local cf2=CFrame.new(bp3)*CFrame.Angles(0,math.rad(ccX2),0)*CFrame.Angles(math.rad(ccY2),0,0)
            local of2=cf2.RightVector*S.camOffX+cf2.UpVector*S.camOffY
            local cp2=bp3+cf2.LookVector*(-8)+of2+Vector3.new(0,1.5,0)
            cam.CFrame=CFrame.new(cp2,bp3+Vector3.new(0,1.5,0))
            cam.FieldOfView=S.fov
        end)
    end

    local fcPos2=Vector3.new(0,10,0)
    local fcY2,fcP2=0,0

    local fcHUD2=New("Frame",{
        Size=UDim2.new(0,240,0,34),Position=UDim2.new(0.5,-120,0,8),
