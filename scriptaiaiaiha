-- Lưu script
local function executeOnce(code, name)
	if #name>0 then print("👤", name) end
	local ok, res = pcall(function()
		local fn, err = (loadstring or function(c) return loadstring(c) end)(code)
		if not fn then error(err) end
		fn()
	end)
	return ok, res
end

local function executeCurrentCode()
	local code, name = codeBox.Text, nameBox.Text
	local loopStr, delayStr = loopBox.Text, delayBox.Text
	local unit = unitButton.Text
	if #code==0 then statusLabel.Text = "⚠️ Vui lòng nhập code!" return end
	local loopCount = tonumber(loopStr) or 1
	if loopCount<=0 or loopCount>1000 then statusLabel.Text="⚠️ Số lần lặp không hợp lệ (1-1000)" return end
	local delay = tonumber(delayStr) or 0
	if delay<0 then statusLabel.Text="⚠️ Thời gian chờ không hợp lệ" return end
	if unit=="Phút" then delay=delay*60 end
	statusLabel.Text = "⏳ Đang thực thi..."
	local okC, failC = 0,0
	for i=1,loopCount do
		if i>1 and delay>0 then task.wait(delay) end
		local ok, err = executeOnce(code, name)
		if ok then okC=okC+1 else failC=failC+1 warn("Lần",i,err) end
		statusLabel.Text = string.format("⏳ %d/%d...", i, loopCount)
	end
	totalExecutions += loopCount
	countLabel.Text = "🔄 Tổng số lần đã chạy: "..totalExecutions
	statusLabel.Text = failC==0 and string.format("✅ %d lần thành công!",loopCount) or string.format("⚠️ %d ok, %d fail",okC,failC)
end

runButton.MouseButton1Click:Connect(executeCurrentCode)

-- Quản lý danh sách script
local function updateCanvas()
	local count = #savedScripts
	local height = yPos + 30 + count*34
	scrollFrame.CanvasSize = UDim2.new(0,0,0,math.max(height,500))
end

local function clearList()
	for _,v in ipairs(scriptListFrame:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
end

local function rebuildList()
	clearList()
	for i, data in ipairs(savedScripts) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1,0,0,30)
		row.BackgroundColor3 = Color3.fromRGB(245,245,245)
		row.BackgroundTransparency = 0.3
		row.BorderSizePixel = 0
		row.Parent = scriptListFrame
		Instance.new("UICorner", row).CornerRadius = UDim.new(0,6)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1,-30,1,0)
		btn.Text = data.name
		btn.BackgroundTransparency = 1
		btn.TextColor3 = Color3.fromRGB(50,50,50)
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 13
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = row
		local del = Instance.new("TextButton")
		del.Size = UDim2.new(0,24,0,24)
		del.Position = UDim2.new(1,-28,0.5,-12)
		del.Text = "✕"
		del.BackgroundColor3 = Color3.fromRGB(200,60,60)
		del.BackgroundTransparency = 0.2
		del.TextColor3 = Color3.fromRGB(255,255,255)
		del.Font = Enum.Font.GothamBold
		del.TextSize = 14
		del.BorderSizePixel = 0
		del.Parent = row
		Instance.new("UICorner", del).CornerRadius = UDim.new(1,0)
		btn.MouseButton1Click:Connect(function()
			nameBox.Text = data.name
			codeBox.Text = data.code
			executeCurrentCode()
		end)
		del.MouseButton1Click:Connect(function()
			table.remove(savedScripts, i)
			rebuildList()
			updateCanvas()
		end)
	end
	updateCanvas()
end

saveButton.MouseButton1Click:Connect(function()
	local n, c = nameBox.Text, codeBox.Text
	if #c==0 then statusLabel.Text="⚠️ Vui lòng nhập code!" return end
	if #n==0 then n = "Script "..(#savedScripts+1) end
	local base, counter = n, 1
	while true do
		local dup = false
		for _, s in ipairs(savedScripts) do if s.name==n then dup=true break end end
		if not dup then break end
		counter += 1
		n = base.." ("..counter..")"
	end
	table.insert(savedScripts, {name=n, code=c})
	rebuildList()
	statusLabel.Text = "✅ Đã lưu: "..n
	scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

