local fpsLbl = New("TextLabel", {
    Size=UDim2.new(0,90,0,22), Position=UDim2.new(0,10,1,-30), Text="",
    BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5,
    TextColor3=Color3.fromRGB(0,255,100), Font=Enum.Font.GothamBold, TextSize=13,
    Visible=false, ZIndex=10,
}, gui)
Corner(fpsLbl,UDim.new(0,6))

local fpsBuf={}
fpsBtn.MouseButton1Click:Connect(function()
    S.fpsCounter=not S.fpsCounter
    fpsLbl.Visible=S.fpsCounter
    fpsBtn.Text=S.fpsCounter and "📈 Hiện FPS: BẬT" or "📈 Hiện FPS: TẮT"
    fpsBtn.BackgroundColor3=S.fpsCounter and Color3.fromRGB(0,180,80) or C.GRAY
    if S.fpsCounter then
        RunService:BindToRenderStep("FPS", Enum.RenderPriority.Last.Value, function(dt)
            table.insert(fpsBuf,dt)
            if #fpsBuf>30 then table.remove(fpsBuf,1) end
            if #fpsBuf>0 then
                local t=0
                for _,v in ipairs(fpsBuf) do t+=v end
                if t>0 then
                    local fps=math.round(#fpsBuf/t)
                    fpsLbl.TextColor3=fps>=55 and Color3.fromRGB(0,255,100) or fps>=30 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,60,60)
                    fpsLbl.Text="FPS: "..fps
                end
            end
        end)
    else
        RunService:UnbindFromRenderStep("FPS")
        fpsBuf={}
        fpsLbl.Text=""
    end
end)

