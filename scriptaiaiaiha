-- Touch handlers
local function handleTouchInput(input, started)
    if started then
        for _, btnData in ipairs({{btnFlyUp, "FlyUp"}, {btnFlyDown, "FlyDown"}}) do
            local btn, key = btnData[1], btnData[2]
            local absPos = btn.AbsolutePosition
            local absSize = btn.AbsoluteSize
            local pos = input.Position
            if pos.X >= absPos.X and pos.X <= absPos.X + absSize.X
                and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y then
                References.mobileKeys[key] = true
                References.activeTouches[input] = key
                break
            end
        end
    else
        if References.activeTouches[input] then
            References.mobileKeys[References.activeTouches[input]] = false
            References.activeTouches[input] = nil
        end
    end
end

UserInputService.TouchStarted:Connect(function(input, processed)
    if not processed then handleTouchInput(input, true) end
end)
UserInputService.TouchEnded:Connect(function(input) handleTouchInput(input, false) end)

