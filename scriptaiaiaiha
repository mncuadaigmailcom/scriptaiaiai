-- FPS Counter
local fpsBuffer  = {}
local FPS_SAMPLE = 30
fpsToggle.MouseButton1Click:Connect(function()
	isFpsShown       = not isFpsShown
	fpsLabel.Visible = isFpsShown
	fpsToggle.Text   = isFpsShown and "📈 FPS Counter: BẬT" or "📈 FPS Counter: TẮT"
	fpsToggle.BackgroundColor3 = isFpsShown
		and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(100, 100, 100)
	if isFpsShown then
		RunService:BindToRenderStep("FpsCounter", Enum.RenderPriority.Last.Value, function(dt)
			table.insert(fpsBuffer, dt)
			if #fpsBuffer > FPS_SAMPLE then table.remove(fpsBuffer, 1) end
			if #fpsBuffer > 0 then
				local avg = 0
				for _, v in ipairs(fpsBuffer) do avg = avg + v end
				local fps = math.round(#fpsBuffer / avg)
				fpsLabel.TextColor3 = fps >= 55 and Color3.fromRGB(0, 255, 100)
					or fps >= 30 and Color3.fromRGB(255, 200, 0)
					or Color3.fromRGB(255, 60, 60)
				fpsLabel.Text = string.format("FPS: %d", fps)
			end
		end)
	else
		RunService:UnbindFromRenderStep("FpsCounter")
		fpsBuffer = {}
		fpsLabel.Text = ""
	end
end)

