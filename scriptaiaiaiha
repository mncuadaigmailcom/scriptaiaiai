local CAM_RENDER = "CustomCam"

local function startCustomCamera()
	local camera = workspace.CurrentCamera
	if not camera then return end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = customFov
	camAngleX, camAngleY = 0, 0
	UserInputService.MouseBehavior    = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	RunService:BindToRenderStep(CAM_RENDER, Enum.RenderPriority.Camera.Value, function()
		if not isCustomCamera or not character then return end
		local root = getRootPart()
		if not root then return end
		local head   = character:FindFirstChild("Head")
		local basePos = (head and head.Position or root.Position) + Vector3.new(0, 2, 0)
		local lookVec = (
			CFrame.Angles(0, math.rad(camAngleX), 0)
			* CFrame.Angles(math.rad(camAngleY), 0, 0)
		).LookVector
		local offset = root.CFrame.RightVector * customOffsetX + Vector3.new(0, customOffsetY, 0)
		camera.CFrame = CFrame.new(basePos + offset - lookVec * 5, basePos + lookVec * 10)
	end)
end

local function stopCustomCamera()
	RunService:UnbindFromRenderStep(CAM_RENDER)
	local cam = workspace.CurrentCamera
	if cam then cam.CameraType = Enum.CameraType.Custom; cam.FieldOfView = 70 end
	UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function toggleCustomCamera()
	isCustomCamera = not isCustomCamera
	cameraToggleButton.Text = isCustomCamera and "📷 Camera: BẬT" or "📷 Camera: TẮT"
	cameraToggleButton.BackgroundColor3 = isCustomCamera
		and Color3.fromRGB(200, 120, 50) or Color3.fromRGB(100, 100, 100)
	if isCustomCamera then startCustomCamera() else stopCustomCamera() end
end
cameraToggleButton.MouseButton1Click:Connect(toggleCustomCamera)

UserInputService.InputChanged:Connect(function(input)
	if not isCustomCamera then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		camAngleX = (camAngleX - input.Delta.X * 0.1) % 360
		camAngleY = math.clamp(camAngleY - input.Delta.Y * 0.1, -80, 80)
	end
end)

