local function tatCamTuDo()
	RunService:UnbindFromRenderStep(TEN_CAM_TD)
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true

	-- Bỏ ghim nhân vật
	local root = layRootPart()
	if root then
		root.Anchored = false
	end
	local hum = layHumanoid()
	if hum then
		hum.AutoRotate = true
		hum.WalkSpeed  = tocDoChay
		hum.JumpPower  = lucNhay
	end

	khungHUDCamTD.Visible = false
	dotCross.Visible       = false
end

local function batCamTuDoFunc()
	local cam = workspace.CurrentCamera
	if not cam then return end

	-- Ghim nhân vật đứng yên
	local root = layRootPart()
	local hum  = layHumanoid()
	if root then
		camTuDoViTri = root.Position + Vector3.new(0, 5, 0)
		root.Anchored = true
	end
	if hum then
		hum.AutoRotate = false
		hum.WalkSpeed  = 0
		hum.JumpPower  = 0
	end

	cam.CameraType  = Enum.CameraType.Scriptable
	cam.FieldOfView = 90
	camTuDoGocX     = 0
	camTuDoGocY     = 0

	UserInputService.MouseBehavior    = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	khungHUDCamTD.Visible = true
	dotCross.Visible       = true

	RunService:BindToRenderStep(TEN_CAM_TD, Enum.RenderPriority.Camera.Value, function(dt)
		if not batCamTuDo then return end

		-- Xoay camera theo chuột
		local delta = UserInputService:GetMouseDelta()
		camTuDoGocX = (camTuDoGocX - delta.X * 0.3) % 360
		camTuDoGocY = math.clamp(camTuDoGocY - delta.Y * 0.3, -89, 89)

		-- Tính CFrame camera
		local cfCam = CFrame.new(camTuDoViTri)
			* CFrame.Angles(0, math.rad(camTuDoGocX), 0)
			* CFrame.Angles(math.rad(camTuDoGocY), 0, 0)

		-- Di chuyển camera bằng phím
		local toc = tocDoCamTuDo * dt
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			toc = toc * 3 -- Tăng tốc với Shift
		end

		local dichChuyen = Vector3.new(0,0,0)
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			dichChuyen = dichChuyen + cfCam.LookVector * toc
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			dichChuyen = dichChuyen - cfCam.LookVector * toc
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			dichChuyen = dichChuyen - cfCam.RightVector * toc
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			dichChuyen = dichChuyen + cfCam.RightVector * toc
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then
			dichChuyen = dichChuyen + Vector3.new(0,1,0) * toc
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			dichChuyen = dichChuyen - Vector3.new(0,1,0) * toc
		end

		camTuDoViTri = camTuDoViTri + dichChuyen

		-- Áp dụng CFrame
		cam.CFrame = CFrame.new(camTuDoViTri)
			* CFrame.Angles(0, math.rad(camTuDoGocX), 0)
			* CFrame.Angles(math.rad(camTuDoGocY), 0, 0)
	end)
end

