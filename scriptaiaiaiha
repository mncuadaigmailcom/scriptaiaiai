local mobileInput = {flyUp = false, flyDown = false}
local touchMap = {}

UserInputService.TouchStarted:Connect(function(input, processed)
    if processed then return end
    local pos = input.Position
    local buttons = {{flyUpBtn, "flyUp"}, {flyDownBtn, "flyDown"}}
    for _, data in ipairs(buttons) do
        local btn, key = data[1], data[2]
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        if pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and
           pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y then
            mobileInput[key] = true
            touchMap[input] = key
            break
        end
    end
end)

UserInputService.TouchEnded:Connect(function(input)
    if touchMap[input] then
        mobileInput[touchMap[input]] = false
        touchMap[input] = nil
    end
end)

local function getVerticalInput()
