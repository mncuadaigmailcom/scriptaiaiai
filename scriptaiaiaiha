local mobileKeys = {FlyUp = false, FlyDown = false}
local activeTouches = {}

local function onTouchStarted(input, processed)
	if processed then return end
	for _, btnData in ipairs({{btnFlyUp, "FlyUp"}, {btnFlyDown, "FlyDown"}}) do
		local btn, key = btnData[1], btnData[2]
		local mousePos = input.Position
		local absPos = btn.AbsolutePosition
		local absSize = btn.AbsoluteSize
		if mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y then
			mobileKeys[key] = true
			activeTouches[input] = key
			break
		end
	end
end

local function onTouchEnded(input)
	if activeTouches[input] then
		mobileKeys[activeTouches[input]] = false
		activeTouches[input] = nil
	end
end

UserInputService.TouchStarted:Connect(onTouchStarted)
UserInputService.TouchEnded:Connect(onTouchEnded)

local function getVerticalInput()
	local up = UserInputService:IsKeyDown(Enum.KeyCode.Space) or mobileKeys.FlyUp
	local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mobileKeys.FlyDown
	return up, down
end

-- Character handling
player.CharacterAdded:Connect(function(char)
	character = char
	if isFlying then stopFly() isFlying = false end
	if isStandingOnAir then stopStandOnAir() isStandingOnAir = false end
	flyButton.Text = "🕊️ Bay: TẮT"
	flyButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	standAirButton.Text = "🧍 Đứng trên không: TẮT"
