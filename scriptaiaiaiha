-- Xử lý kéo joystick -> xoay camera
local function updateJoystick(inp)
	if not joyDang or not batCamTD then return end
	local delta=Vector2.new(inp.Position.X,inp.Position.Y)-joyBatDau
	joyBatDau=Vector2.new(inp.Position.X,inp.Position.Y)
	-- Giới hạn dot trong vòng tròn
	local dx=math.clamp(inp.Position.X-(khungJoy.AbsolutePosition.X+50),-38,38)
	local dy=math.clamp(inp.Position.Y-(khungJoy.AbsolutePosition.Y+50),-38,38)
	dotJoy.Position=UDim2.new(0.5,dx-12,0.5,dy-12)
	-- Xoay camera
	camTDGocX=(camTDGocX-delta.X*0.4)%360
	camTDGocY=math.clamp(camTDGocY-delta.Y*0.4,-89,89)
end

-- TEN_CAM_TD
local TEN_CAM_TD="CamTD"

local function tatCamTDFn()
	RunService:UnbindFromRenderStep(TEN_CAM_TD)
	local cam=workspace.CurrentCamera
	if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end

	-- Bỏ ghim nhân vật
	local root=getRoot()
	if root then root.Anchored=false end
	local hum=getHum()
	if hum then hum.AutoRotate=true; hum.WalkSpeed=tocDoChay; hum.JumpPower=lucNhay end

	-- Ẩn UI
	hudCamTD.Visible=false
	panelCam.Visible=false
	khungJoy.Visible=false
	joyDang=false
	dotJoy.Position=UDim2.new(0.5,-12,0.5,-12)
	-- Reset tất cả trạng thái nút
	for k in pairs(camBtnState) do camBtnState[k]=false end
end

local function batCamTDFn()
	local cam=workspace.CurrentCamera; if not cam then return end
	local root=getRoot(); local hum=getHum()

	-- Lưu vị trí để bắt đầu từ đó
	if root then
		camTuDoViTri=(root.Position+Vector3.new(0,5,0))
		-- Ghim nhân vật
		root.Anchored=true
	end
	if hum then
		hum.AutoRotate=false
		hum.WalkSpeed=0
		hum.JumpPower=0
	end

	cam.CameraType=Enum.CameraType.Scriptable
	cam.FieldOfView=90
	camTDGocX=0; camTDGocY=0

	-- Hiện UI
	hudCamTD.Visible=true
	panelCam.Visible=true
	khungJoy.Visible=true

	RunService:BindToRenderStep(TEN_CAM_TD,Enum.RenderPriority.Camera.Value,function(dt)
		if not batCamTD then return end

		-- Tính tốc độ
		local toc=tocDoCamTD*dt
		if camBtnState.Fast then toc=toc*4 end

		-- Tính CFrame dựa theo góc xoay
		local cfGoc=CFrame.new(camTDViTri)
			*CFrame.Angles(0,math.rad(camTDGocX),0)
			*CFrame.Angles(math.rad(camTDGocY),0,0)

		local lookVec=cfGoc.LookVector
		local rightVec=cfGoc.RightVector

		-- Di chuyển từ nút màn hình
		if camBtnState.W then camTDViTri=camTDViTri+lookVec*toc end
		if camBtnState.S then camTDViTri=camTDViTri-lookVec*toc end
		if camBtnState.A then camTDViTri=camTDViTri-rightVec*toc end
		if camBtnState.D then camTDViTri=camTDViTri+rightVec*toc end
		if camBtnState.Q then camTDViTri=camTDViTri+Vector3.new(0,1,0)*toc end -- Lên
		if camBtnState.E then camTDViTri=camTDViTri-Vector3.new(0,1,0)*toc end -- Xuống

		-- Áp dụng
		cam.CFrame=CFrame.new(camTDViTri)
			*CFrame.Angles(0,math.rad(camTDGocX),0)
			*CFrame.Angles(math.rad(camTDGocY),0,0)
	end)
end

local function togCamTD()
	-- Tắt camera TC nếu đang bật
	if batCamTC then
		batCamTC=false
		nutCamTC.Text="📷 Camera tùy chỉnh: TẮT"
		nutCamTC.BackgroundColor3=Color3.fromRGB(100,100,100)
		tatCamTCFn()
	end
	batCamTD=not batCamTD
	nutCamTD.Text=batCamTD and "🎥 Camera tự do: BẬT" or "🎥 Camera tự do: TẮT"
	nutCamTD.BackgroundColor3=batCamTD and Color3.fromRGB(0,160,200) or Color3.fromRGB(100,100,100)
	if batCamTD then batCamTDFn() else tatCamTDFn() end
end
