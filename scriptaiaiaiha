	nutThamKinh.BackgroundColor3=dangThamKinh and Color3.fromRGB(160,100,200) or Color3.fromRGB(100,100,100)
	local root=getRoot(); if not root then return end
	if dangThamKinh then if dangBay then togBay() end; taoTham(root.Position.Y-3.5) else dungThamFn() end
end

