	standPlatform = createInstance("Part", {
		Name = "MagicCarpet",
		Size = Vector3.new(carpetSize, 0.5, carpetSize),
		Transparency = 0.7,
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.Glass,
		Anchored = true,
		CanCollide = true,
		Position = Vector3.new(root.Position.X, yOffset, root.Position.Z),
	}, workspace)
	standBodyPosition = createInstance("BodyPosition", {
		MaxForce = Vector3.new(0, 50000, 0),
		P = 5000, D = 500,
		Position = Vector3.new(root.Position.X, yOffset + 3, root.Position.Z),
	}, root)
