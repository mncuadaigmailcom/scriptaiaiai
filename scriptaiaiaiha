-- ==================== NOCLIP ====================
local function enableNoClip()
	RunService:BindToRenderStep("NoClip", 1, function()
		if not isNoClipOn or not character then return end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end)
end

local function disableNoClip()
	RunService:UnbindFromRenderStep("NoClip")
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end
	end
end

local function toggleNoClip()
	isNoClipOn = not isNoClipOn
	noClipButton.Text = isNoClipOn and "🚶‍♂️ NoClip: BẬT" or "🚶‍♂️ NoClip: TẮT"
	noClipButton.BackgroundColor3 = isNoClipOn
		and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(100, 100, 100)
	if isNoClipOn then enableNoClip() else disableNoClip() end
end
