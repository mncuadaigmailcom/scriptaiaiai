-- Cập nhật UI và áp dụng WalkSpeed/JumpPower cho character
local function applyCharacterSpeed()
	if not character or not character:FindFirstChild("Humanoid") then return end
	local hum = character.Humanoid
	hum.WalkSpeed = walkSpeed
	hum.JumpPower = jumpPower
	walkSpeedLabel.Text = "Hiện tại: " .. walkSpeed
	jumpPowerLabel.Text = "Hiện tại: " .. jumpPower
end

-- NoClip functions
local function enableNoClip()
	if not character then return end
	RunService:BindToRenderStep("NoClip", 1, function()
		if not isNoClipOn or not character then return end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end)
end

local function disableNoClip()
	RunService:UnbindFromRenderStep("NoClip")
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

local function toggleNoClip()
	isNoClipOn = not isNoClipOn
	noClipButton.Text = isNoClipOn and "🚶‍♂️ NoClip: BẬT" or "🚶‍♂️ NoClip: TẮT"
	noClipButton.BackgroundColor3 = isNoClipOn and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(100, 100, 100)
	if isNoClipOn then
		enableNoClip()
	else
		disableNoClip()
	end
end

noClipButton.MouseButton1Click:Connect(toggleNoClip)

