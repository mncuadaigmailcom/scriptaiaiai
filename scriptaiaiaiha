fpsButton.MouseButton1Click:Connect(function()
    state.fpsCounter = not state.fpsCounter
    fpsLabel.Visible = state.fpsCounter
    fpsButton.Text = state.fpsCounter and "📈 Hiện FPS: BẬT" or "📈 Hiện FPS: TẮT"
    fpsButton.BackgroundColor3 = state.fpsCounter and Color3.fromRGB(0, 180, 80) or COLOR.GRAY
    
    if state.fpsCounter then
        RunService:BindToRenderStep("FPSCounter", Enum.RenderPriority.Last.Value, function(dt)
            table.insert(fpsBuffer, dt)
            if #fpsBuffer > 30 then table.remove(fpsBuffer, 1) end
            if #fpsBuffer > 0 then
                local total = 0
                for _, v in ipairs(fpsBuffer) do total += v end
                local fps = math.round(#fpsBuffer / total)
                fpsLabel.TextColor3 = fps >= 55 and Color3.fromRGB(0, 255, 100) or
                                     fps >= 30 and Color3.fromRGB(255, 200, 0) or
                                     Color3.fromRGB(255, 60, 60)
                fpsLabel.Text = "FPS: " .. fps
            end
        end)
    else
        RunService:UnbindFromRenderStep("FPSCounter")
        fpsBuffer = {}
        fpsLabel.Text = ""
    end
end)

