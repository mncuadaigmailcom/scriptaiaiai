        Size=UDim2.new(0,8,0,8),Position=UDim2.new(0.5,-4,0.5,-4),
        BackgroundColor3=C.WHITE,BackgroundTransparency=0.2,
        BorderSizePixel=0,Visible=false,ZIndex=100,
    },gui)
    Corner(cross2,UDim.new(1,0))

    local function DisFC2()
        RunService:UnbindFromRenderStep("FC2")
        local cam=workspace.CurrentCamera
        if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end
        UserInputService.MouseBehavior=Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled=true
        local r=Root(); if r then r.Anchored=false end
        local h=Hum()
        if h then h.AutoRotate=true; h.WalkSpeed=S.walkSpeed; h.JumpPower=S.jumpPower end
        fcHUD2.Visible=false; cross2.Visible=false
    end
    local function EnFC2()
        local cam=workspace.CurrentCamera; if not cam then return end
        local r=Root(); local h=Hum()
        if r then fcPos2=r.Position+Vector3.new(0,5,0); r.Anchored=true end
        if h then h.AutoRotate=false; h.WalkSpeed=0; h.JumpPower=0 end
        cam.CameraType=Enum.CameraType.Scriptable; cam.FieldOfView=90
        fcY2=0; fcP2=0
        UserInputService.MouseBehavior=Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled=false
        fcHUD2.Visible=true; cross2.Visible=true
        RunService:BindToRenderStep("FC2",Enum.RenderPriority.Camera.Value,function(dt)
            if not S.freeCam then return end
            local dm=UserInputService:GetMouseDelta()
            fcY2=(fcY2-dm.X*0.28)%360
            fcP2=math.clamp(fcP2-dm.Y*0.28,-88,88)
            local cf3=CFrame.new(fcPos2)*CFrame.Angles(0,math.rad(fcY2),0)*CFrame.Angles(math.rad(fcP2),0,0)
            local sp=S.freeCamSpeed*dt
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then sp=sp*3 end
            local mv=Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv=mv+cf3.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv=mv-cf3.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv=mv-cf3.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv=mv+cf3.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then mv=mv-Vector3.new(0,1,0) end
            fcPos2=fcPos2+mv*sp
            cam.CFrame=CFrame.new(fcPos2)*CFrame.Angles(0,math.rad(fcY2),0)*CFrame.Angles(math.rad(fcP2),0,0)
        end)
    end

    _G.__exDisCC=function() if S.customCam then S.customCam=false; DisCC2() end end
    _G.__exDisFC=function() if S.freeCam then S.freeCam=false; DisFC2() end end

    UserInputService.InputChanged:Connect(function(i)
        if S.customCam and rMouse2 and i.UserInputType==Enum.UserInputType.MouseMovement then
            ccX2=(ccX2-i.Delta.X*0.32)%360
