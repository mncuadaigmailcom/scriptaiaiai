local tabBtns    = {}  -- nút sidebar
local tabFrames  = {}  -- scrolling frame nội dung
local activeKey  = nil

local function switchTab(key)
    if activeKey==key then return end
    activeKey=key
    for k,sf in pairs(tabFrames) do sf.Visible=(k==key) end
    for k,btn in pairs(tabBtns) do
        if k==key then
            btn.BackgroundColor3=C.BLUE
            btn.BackgroundTransparency=0.05
            for _,ch in ipairs(btn:GetChildren()) do
                if ch:IsA("TextLabel") then ch.TextColor3=C.WHITE end
            end
        else
            btn.BackgroundColor3=C.PANEL
            btn.BackgroundTransparency=0.1
            for _,ch in ipairs(btn:GetChildren()) do
                if ch:IsA("TextLabel") then
                    if ch.TextSize>=18 then ch.TextColor3=C.DARK
                    else ch.TextColor3=Color3.fromRGB(90,90,110) end
                end
            end
        end
    end
end

