local function batCamTCFn()
	local cam=workspace.CurrentCamera; if not cam then return end
	camTCGocX=0; camTCGocY=10
	cam.CameraType=Enum.CameraType.Scriptable; cam.FieldOfView=fovTC
	RunService:BindToRenderStep(TEN_CAM_TC,Enum.RenderPriority.Camera.Value,function()
		if not batCamTC then return end
		local root=getRoot(); if not root then return end
		local head=nhanVat and nhanVat:FindFirstChild("Head")
		local goc=(head and head.Position or root.Position)+Vector3.new(0,1.5,0)
		local cf=CFrame.new(goc)*CFrame.Angles(0,math.rad(camTCGocX),0)*CFrame.Angles(math.rad(camTCGocY),0,0)
		local lech=cf.RightVector*offCamX+cf.UpVector*offCamY
		cam.CFrame=CFrame.new(goc+cf.LookVector*(-8)+lech,goc)
		cam.FieldOfView=fovTC
	end)
end
