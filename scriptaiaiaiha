-- ============ WIDGET BUILDERS ============
-- Tất cả widget đặt vào ScrollingFrame của tab tương ứng
-- y = offset từ đầu canvas

local function Lbl(par,txt,y,col,sz)
    local l=New("TextLabel",{
        Size=UDim2.new(1,-16,0,15),
        Position=UDim2.new(0,8,0,y),
        Text=txt,
        BackgroundTransparency=1,
        TextColor3=col or Color3.fromRGB(70,70,85),
        Font=Enum.Font.GothamMedium,
        TextSize=sz or 10,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=12,
    },par)
    return l
end

local function Inp(par,txt,y,w,h,ml)
    local b=New("TextBox",{
        Size=UDim2.new(0,w or 240,0,h or 23),
        Position=UDim2.new(0,8,0,y),
        Text=txt or "",
        PlaceholderColor3=Color3.fromRGB(170,170,185),
        BackgroundColor3=Color3.fromRGB(252,252,255),
        BackgroundTransparency=0.1,
        TextColor3=C.DARK,
        Font=Enum.Font.GothamMedium,
        TextSize=12,
        BorderSizePixel=0,
        ClearTextOnFocus=false,
        ZIndex=12,
    },par)
    if ml then b.MultiLine=true; b.TextWrapped=true; b.TextXAlignment=Enum.TextXAlignment.Left; b.TextYAlignment=Enum.TextYAlignment.Top end
    Corner(b,UDim.new(0,6)); Stroke(b,Color3.fromRGB(200,200,215),1)
    return b
end

local function Btn(par,txt,x,y,w,h,col)
    local bc=col or C.GRAY
    local b=New("TextButton",{
        Size=UDim2.new(0,w or 110,0,h or 25),
        Position=UDim2.new(0,x,0,y),
        Text=txt,
        BackgroundColor3=bc,
        BackgroundTransparency=0.1,
        TextColor3=Color3.fromRGB(255,255,255),
        Font=Enum.Font.GothamBold,
        TextSize=10,
        BorderSizePixel=0,
        ZIndex=12,
    },par)
    Corner(b,UDim.new(0,6))
    Stroke(b,bc:Lerp(Color3.new(0,0,0),0.25),1)
    b.MouseEnter:Connect(function() Twn(b,{BackgroundTransparency=0.0}) end)
    b.MouseLeave:Connect(function() Twn(b,{BackgroundTransparency=0.1}) end)
    return b
end

