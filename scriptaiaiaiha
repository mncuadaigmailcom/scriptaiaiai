        if i.KeyCode==Enum.KeyCode.F and S.freeCam then
            S.freeCam=false; DisFC2()
            fcBtn.Text="🎥 Camera Tự Do: TẮT"; fcBtn.BackgroundColor3=C.GRAY
        end
        if i.UserInputType==Enum.UserInputType.MouseButton2 then
            rMouse2=true
            if S.customCam then UserInputService.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton2 then
            rMouse2=false
            if S.customCam then UserInputService.MouseBehavior=Enum.MouseBehavior.Default end
        end
    end)

    ccBtn.MouseButton1Click:Connect(function()
        if S.freeCam then return end
        S.customCam=not S.customCam
        if S.customCam then EnCC2() else DisCC2() end
        ccBtn.Text=S.customCam and "📷 Camera Tùy Chỉnh: BẬT" or "📷 Camera Tùy Chỉnh: TẮT"
        ccBtn.BackgroundColor3=S.customCam and C.ORANGE or C.GRAY
    end)
    fcBtn.MouseButton1Click:Connect(function()
        if S.customCam then S.customCam=false; DisCC2(); ccBtn.Text="📷 Camera Tùy Chỉnh: TẮT"; ccBtn.BackgroundColor3=C.GRAY end
        S.freeCam=not S.freeCam
        if S.freeCam then EnFC2() else DisFC2() end
        fcBtn.Text=S.freeCam and "🎥 Camera Tự Do: BẬT" or "🎥 Camera Tự Do: TẮT"
        fcBtn.BackgroundColor3=S.freeCam and Color3.fromRGB(0,165,210) or C.GRAY
    end)
    fovIn.FocusLost:Connect(function(e) if not e then return end; local n=tonumber(fovIn.Text); if n and n>=30 and n<=120 then S.fov=n else fovIn.Text=tostring(S.fov) end end)
    offXIn.FocusLost:Connect(function(e) if not e then return end; local n=tonumber(offXIn.Text); if n then S.camOffX=n else offXIn.Text=tostring(S.camOffX) end end)
    offYIn.FocusLost:Connect(function(e) if not e then return end; local n=tonumber(offYIn.Text); if n then S.camOffY=n else offYIn.Text=tostring(S.camOffY) end end)
    fcSpdIn.FocusLost:Connect(function(e) if not e then return end; local n=tonumber(fcSpdIn.Text); if n and n>0 then S.freeCamSpeed=n else fcSpdIn.Text=tostring(S.freeCamSpeed) end end)
