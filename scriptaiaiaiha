-- Fly physics objects
local bodyVelocity, bodyGyro, floorPlatform
local carpetPart, bodyPosition

local function stopFly()
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    if floorPlatform then floorPlatform:Destroy(); floorPlatform = nil end
    
    local hum = getHumanoid()
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
    end
    
    RunService:UnbindFromRenderStep("FlyUpdate")
    updateMobileVisibility()
end

local function stopCarpet()
    if carpetPart then carpetPart:Destroy(); carpetPart = nil end
    if bodyPosition then bodyPosition:Destroy(); bodyPosition = nil end
    RunService:UnbindFromRenderStep("CarpetUpdate")
    state.carpetYOffset = nil
end

local function createCarpet(yOffset)
    local root = getRootPart()
    if not root then return end
    
    carpetPart = create("Part", {
        Name = "MagicCarpet",
        Size = Vector3.new(state.carpetSize, 0.5, state.carpetSize),
        Transparency = 0.7,
        Color = Color3.fromRGB(200, 230, 255),
        Material = Enum.Material.Glass,
        Anchored = true,
        CanCollide = true,
        Position = Vector3.new(root.Position.X, yOffset, root.Position.Z),
    }, workspace)
    
    bodyPosition = create("BodyPosition", {
        MaxForce = Vector3.new(0, 50000, 0),
        P = 5000,
        D = 500,
        Position = Vector3.new(root.Position.X, yOffset + 3, root.Position.Z),
    }, root)
    
    state.carpetYOffset = yOffset
    
    RunService:BindToRenderStep("CarpetUpdate", 1, function()
        if not state.carpet or not carpetPart or not root or not bodyPosition then return end
        local x, z = root.Position.X, root.Position.Z
        carpetPart.Position = Vector3.new(x, state.carpetYOffset, z)
        bodyPosition.Position = Vector3.new(x, state.carpetYOffset + 3, z)
    end)
end

local function toggleFly()
    state.flying = not state.flying
    local root = getRootPart()
    local hum = getHumanoid()
    if not root then return end
    
    if state.flying then
        -- Tắt thảm kính nếu đang bật
        if state.carpet then
            stopCarpet()
            state.carpet = false
        end
        -- Tắt bay chạy bộ nếu đang bật
        if state.flyRun then
            stopFlyRun()
            state.flyRun = false
        end
        
        bodyVelocity = create("BodyVelocity", {
            MaxForce = Vector3.new(4000, 4000, 4000),
        }, root)
        
        bodyGyro = create("BodyGyro", {
            MaxTorque = Vector3.new(4000, 4000, 4000),
        }, root)
        
        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = true
        end
        
        if not floorPlatform then
            floorPlatform = create("Part", {
                Name = "FlyFloor",
                Size = Vector3.new(6, 0.2, 6),
                Transparency = 0.7,
                Color = Color3.fromRGB(200, 230, 255),
                Material = Enum.Material.Glass,
                Anchored = true,
                CanCollide = false,
            }, workspace)
        end
        
        RunService:BindToRenderStep("FlyUpdate", 1, function()
            if not state.flying or not root or not bodyVelocity then return end
            
            local direction = hum and hum.MoveDirection or Vector3.zero
            local target = root.CFrame:VectorToWorldSpace(direction)
            if target.Magnitude > 0 then target = target.Unit end
            
            local up, down = getVerticalInput()
            local vertical = (up and 1 or 0) - (down and 1 or 0)
            
            bodyVelocity.Velocity = (target + Vector3.new(0, vertical, 0)) * state.flySpeed
            bodyGyro.CFrame = CFrame.new(root.Position,
                root.Position + workspace.CurrentCamera.CFrame.LookVector)
            
            if floorPlatform then
                floorPlatform.Position = root.Position - Vector3.new(0, 3.5, 0)
            end
        end)
    else
        stopFly()
    end
    
    updateMobileVisibility()
end

local function toggleCarpet()
    state.carpet = not state.carpet
    local root = getRootPart()
    if not root then return end
    
    if state.carpet then
        -- Tắt bay nếu đang bật
        if state.flying then toggleFly() end
        createCarpet(root.Position.Y - 3.5)
    else
        stopCarpet()
    end
end

