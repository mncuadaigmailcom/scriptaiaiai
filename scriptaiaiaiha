-- NoClip
local function enableNoClip()
	if not character then return end
	RunService:BindToRenderStep("NoClip", 1, function()
		if not isNoClipOn or not character then return end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end)
end

local function disableNoClip()
	RunService:UnbindFromRenderStep("NoClip")
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

local function toggleNoClip()
	isNoClipOn = not isNoClipOn
	noClipButton.Text = isNoClipOn and "🚶‍♂️ NoClip: BẬT" or "🚶‍♂️ NoClip: TẮT"
	noClipButton.BackgroundColor3 = isNoClipOn and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(100, 100, 100)
	if isNoClipOn then enableNoClip() else disableNoClip() end
end

noClipButton.MouseButton1Click:Connect(toggleNoClip)

-- Camera tùy chỉnh
local function startCustomCamera()
	local camera = workspace.CurrentCamera
	if not camera then return end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = customFov
	camAngleX = 0
	camAngleY = 0

	RunService:BindToRenderStep(cameraRenderStepName, Enum.RenderPriority.Camera.Value, function(dt)
		if not isCustomCamera or not character or not character:FindFirstChild("HumanoidRootPart") then return end
		local root = character.HumanoidRootPart
		local head = character:FindFirstChild("Head")
		local lookVector = root.CFrame.LookVector
		local rightVector = root.CFrame.RightVector

		-- Vị trí camera mặc định (sau vai)
		local basePos = (head and head.Position or root.Position) + Vector3.new(0, 2, 0)
		local cameraOffset = rightVector * customOffsetX + Vector3.new(0, customOffsetY, 0)
		local cameraPos = basePos + cameraOffset - lookVector * 5  -- cách xa 5 studs

		-- Xoay camera theo góc nhìn
		local rotation = CFrame.Angles(0, 0, 0) * CFrame.Angles(math.rad(camAngleY), math.rad(camAngleX), 0)
		local lookAt = basePos + rotation.LookVector * 10
		camera.CFrame = CFrame.new(cameraPos, lookAt)
	end)

	-- Lắng nghe chuột để xoay
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
end

local function stopCustomCamera()
	RunService:UnbindFromRenderStep(cameraRenderStepName)
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function toggleCustomCamera()
	isCustomCamera = not isCustomCamera
	cameraToggleButton.Text = isCustomCamera and "📷 Camera: BẬT" or "📷 Camera: TẮT"
	cameraToggleButton.BackgroundColor3 = isCustomCamera and Color3.fromRGB(200, 120, 50) or Color3.fromRGB(100, 100, 100)
	if isCustomCamera then
		startCustomCamera()
	else
		stopCustomCamera()
	end
end

cameraToggleButton.MouseButton1Click:Connect(toggleCustomCamera)

