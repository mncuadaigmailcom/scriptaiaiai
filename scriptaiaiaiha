local touchMap = {{btnFlyUp, "FlyUp"}, {btnFlyDown, "FlyDown"}}
UserInputService.TouchStarted:Connect(function(input, processed)
	if processed then return end
	local pos = input.Position
	for _, entry in ipairs(touchMap) do
		local btn, key = entry[1], entry[2]
		local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
		if pos.X >= ap.X and pos.X <= ap.X + as.X
			and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
			mobileKeys[key] = true
			activeTouches[input] = key
			break
		end
	end
end)
UserInputService.TouchEnded:Connect(function(input)
	if activeTouches[input] then
		mobileKeys[activeTouches[input]] = false
		activeTouches[input] = nil
	end
end)

