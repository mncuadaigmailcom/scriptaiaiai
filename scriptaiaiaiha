local function disableFreeCamera()
    RunService:UnbindFromRenderStep("FreeCam")
    
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        cam.FieldOfView = 70
    end
    
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    
    local root = getRootPart()
    if root then root.Anchored = false end
    
    local hum = getHumanoid()
    if hum then
        hum.AutoRotate = true
        hum.WalkSpeed = state.walkSpeed
        hum.JumpPower = state.jumpPower
    end
    
    freeCamHUD.Visible = false
    crosshair.Visible = false
end

local function enableFreeCamera()
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local root = getRootPart()
    local hum = getHumanoid()
    
    if root then
        freeCamPos = root.Position + Vector3.new(0, 5, 0)
        root.Anchored = true
    end
    
    if hum then
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end
    
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = 90
    freeCamYaw = 0
    freeCamPitch = 0
    
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false
    
    freeCamHUD.Visible = true
    crosshair.Visible = true
    
    RunService:BindToRenderStep("FreeCam", Enum.RenderPriority.Camera.Value, function(dt)
        if not state.freeCam then return end
        
        local delta = UserInputService:GetMouseDelta()
        freeCamYaw = (freeCamYaw - delta.X * 0.3) % 360
        freeCamPitch = math.clamp(freeCamPitch - delta.Y * 0.3, -89, 89)
        
        local cf = CFrame.new(freeCamPos) *
                  CFrame.Angles(0, math.rad(freeCamYaw), 0) *
                  CFrame.Angles(math.rad(freeCamPitch), 0, 0)
        
        local speed = state.freeCamSpeed * dt
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            speed = speed * 3
        end
        
        local move = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.new(0, 1, 0) end
        
        freeCamPos += move * speed
        cam.CFrame = CFrame.new(freeCamPos) *
                     CFrame.Angles(0, math.rad(freeCamYaw), 0) *
                     CFrame.Angles(math.rad(freeCamPitch), 0, 0)
    end)
end

local function toggleFreeCamera()
    if state.customCamera then
        state.customCamera = false
        disableCustomCamera()
    end
    
    state.freeCam = not state.freeCam
    
    if state.freeCam then
        enableFreeCamera()
    else
        disableFreeCamera()
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Enum.KeyCode.F and state.freeCam then
        toggleFreeCamera()
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = true
        if state.customCamera then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = false
        if state.customCamera then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end
end)

-- ==================== CODE EXECUTION ====================
local function executeOnce(code, name)
    if #name > 0 then print("👤 Chạy bởi:", name) end
    return pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)
end

local function cancelExecution()
    isCancelled = true
    if currentThread then task.cancel(currentThread); currentThread = nil end
    if currentScriptIndicator then
        currentScriptIndicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        currentScriptIndicator = nil
    end
end

local function runCode(code, name, indicator, times, delay)
    cancelExecution()
    
    if #code == 0 then return false, "⚠️ Vui lòng nhập code!" end
    
    isCancelled = false
    if indicator then
        currentScriptIndicator = indicator
        indicator.BackgroundColor3 = COLOR.RED
    end
    
    local okCount = 0
    local failCount = 0
    
    currentThread = task.spawn(function()
        for i = 1, times do
            if isCancelled then break end
            
            if i > 1 and delay > 0 then
                local elapsed = 0
                while elapsed < delay do
                    if isCancelled then break end
                    task.wait(0.1)
                    elapsed += 0.1
                end
                if isCancelled then break end
            end
            
            local ok, err = executeOnce(code, name)
            if ok then
                okCount += 1
            else
                failCount += 1
                warn("❌ Lần", i, err)
            end
        end
        
        totalRuns += okCount + failCount
        
        if indicator then
            indicator.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            if currentScriptIndicator == indicator then
                currentScriptIndicator = nil
            end
        end
        
        currentThread = nil
    end)
    
    return true, nil
end

