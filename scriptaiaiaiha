local function CreateCarpet(y)
    local r=Root(); if not r then return end
    cp=New("Part",{
        Name="Carpet",Size=Vector3.new(S.carpetSize,0.5,S.carpetSize),
        Transparency=0.7,Color=Color3.fromRGB(200,230,255),
        Material=Enum.Material.Glass,Anchored=true,CanCollide=true,
        Position=Vector3.new(r.Position.X,y,r.Position.Z),
    },workspace)
    bp=New("BodyPosition",{
        MaxForce=Vector3.new(0,50000,0),P=5000,D=500,
        Position=Vector3.new(r.Position.X,y+3,r.Position.Z),
    },r)
    S.carpetY=y
    RunService:BindToRenderStep("Carpet",1,function()
        if not S.carpet or not cp or not r or not bp then return end
        local x,z=r.Position.X,r.Position.Z
        cp.Position=Vector3.new(x,S.carpetY,z)
        bp.Position=Vector3.new(x,S.carpetY+3,z)
    end)
end

