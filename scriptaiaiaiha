local function stopStorm()
	if stormEmitter then stormEmitter:Destroy(); stormEmitter = nil end
	if stormWindSound then stormWindSound:Destroy(); stormWindSound = nil end
	if stormThunderSound then stormThunderSound:Destroy(); stormThunderSound = nil end
	for _, bolt in ipairs(lightningParts) do bolt:Destroy() end
	lightningParts = {}
	isStorming = false
	stormButton.Text = "🌪️ Bão"
	stormButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
end
local function startStorm()
	stopRain(); stopWinter()
	if not workspace:FindFirstChild("StormSystem") then
		local stormPart = Instance.new("Part")
		stormPart.Name = "StormSystem"
		stormPart.Size = Vector3.new(200, 80, 200)
		stormPart.Position = Vector3.new(0, 80, 0)
		stormPart.Transparency = 1
		stormPart.Anchored = true
		stormPart.CanCollide = false
		stormPart.Parent = workspace

		stormEmitter = Instance.new("ParticleEmitter")
		stormEmitter.Texture = "rbxassetid://166777938"
		stormEmitter.Rate = 800
		stormEmitter.Speed = NumberRange.new(25, 40)
		stormEmitter.Lifetime = NumberRange.new(0.3, 0.7)
		stormEmitter.SpreadAngle = Vector2.new(30, 30)
		stormEmitter.Acceleration = Vector3.new(20, -60, 0)
