-- ==================== CHARACTER RESPAWN ====================
player.CharacterAdded:Connect(function(char)
    character = char
    task.wait(0.1)
    
    local hum = getHumanoid()
    if hum then updateCharacterProperties() end
    
    -- Reset fly states
    if state.flying then stopFly(); state.flying = false end
    if state.carpet then stopCarpet(); state.carpet = false end
    if state.flyRun then stopFlyRun(); state.flyRun = false end
    
    -- Reset camera states
    if state.freeCam then
        state.freeCam = false
        disableFreeCamera()
    end
    if state.customCamera then
        state.customCamera = false
        disableCustomCamera()
    end
    
    -- Re-enable NoClip if active
    if state.noClip then enableNoClip() end
    
    -- Reset UI buttons
    flyButton.Text = "🕊️ Bay: TẮT"
    flyButton.BackgroundColor3 = COLOR.GRAY
    carpetButton.Text = "🪩 Thảm kính: TẮT"
    carpetButton.BackgroundColor3 = COLOR.GRAY
    flyRunButton.Text = "🕹️ Bay chạy bộ: TẮT"
    flyRunButton.BackgroundColor3 = COLOR.GRAY
    
    flyRunOverlay.Visible = false
    mobileControls.Visible = false
end)

