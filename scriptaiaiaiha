local function applyGraphicsPreset(presetKey)
    local preset = GRAPHICS_PRESETS[presetKey]
    if not preset then return end
    
    pcall(function() settings().Rendering.QualityLevel = preset.level end)
    Lighting.ShadowSoftness = preset.shadow
    Lighting.GlobalShadows = preset.shadows
    Lighting.EnvironmentDiffuseScale = preset.diffuse
    Lighting.EnvironmentSpecularScale = preset.specular
    
    local names = {
        Ultra = "✨ Siêu cao",
        High = "🔵 Cao",
        Medium = "🟡 Trung bình",
        Low = "🟢 Thấp",
        UltraLow = "⚡ Siêu thấp",
    }
    
    qualityLabel.Text = "📊 Chất lượng: " .. (names[presetKey] or presetKey)
    qualityLabel.TextColor3 = presetKey == "Ultra" and Color3.fromRGB(220, 80, 80) or Color3.fromRGB(0, 140, 70)
    
    state.shadows = preset.shadows
end

