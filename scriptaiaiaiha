local function createLabel(text, y)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -20, 0, 16)
	lbl.Position = UDim2.new(0, 10, 0, y)
	lbl.Text = text
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(60, 60, 60)
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = scrollFrame
	return lbl
end

local function createTextBox(placeholder, y, height, multiline)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -20, 0, height)
	box.Position = UDim2.new(0, 10, 0, y)
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(160, 160, 160)
	box.Text = ""
	box.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	box.BackgroundTransparency = 0.3
	box.TextColor3 = Color3.fromRGB(30, 30, 30)
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 13
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	if multiline then
		box.MultiLine = true
		box.TextWrapped = true
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
	end
	box.Parent = scrollFrame
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
	Instance.new("UIStroke", box).Color = Color3.fromRGB(140, 140, 140)
	Instance.new("UIStroke", box).Thickness = 1.5
	return box
end

local function createButton(text, y, w, h, accentColor)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, w, 0, h)
	btn.Position = UDim2.new(0.5, -w/2, 0, y)
	btn.Text = text
	btn.BackgroundColor3 = accentColor or Color3.fromRGB(0, 160, 100)
	btn.BackgroundTransparency = 0.2
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.BorderSizePixel = 0
	btn.Parent = scrollFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
	local btnStroke = Instance.new("UIStroke", btn)
	btnStroke.Color = accentColor and accentColor:Lerp(Color3.new(0,0,0), 0.4) or Color3.fromRGB(0, 100, 70)
	btnStroke.Thickness = 1.5
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = accentColor and accentColor:Lerp(Color3.new(1,1,1), 0.3) or Color3.fromRGB(0, 200, 130)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = accentColor or Color3.fromRGB(0, 160, 100)}):Play()
	end)
	return btn
end

