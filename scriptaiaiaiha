-- Script management
local function rebuildScriptList()
    for _, child in ipairs(scriptListFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for i, data in ipairs(scripts) do
        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = COLOR.BG,
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0,
        }, scriptListFrame)
        addCorner(row, UDim.new(0, 5))
        addStroke(row)
        
        local runScriptBtn = create("TextButton", {
            Size = UDim2.new(1, -46, 1, 0),
            Text = data.name,
            BackgroundTransparency = 1,
            TextColor3 = COLOR.DARK,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        
        local indicator = create("TextButton", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(1, -40, 0.5, -7),
            Text = "",
            BackgroundColor3 = COLOR.BLUE,
            BorderSizePixel = 0,
        }, row)
        addCorner(indicator, UDim.new(1, 0))
        
        local deleteBtn = create("TextButton", {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(1, -22, 0.5, -10),
            Text = "✕",
            BackgroundColor3 = COLOR.RED,
            BackgroundTransparency = 0.2,
            TextColor3 = COLOR.WHITE,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            BorderSizePixel = 0,
        }, row)
        addCorner(deleteBtn, UDim.new(1, 0))
        
        local idx = i
        indicator.MouseButton1Click:Connect(function()
            if currentScriptIndicator == indicator then cancelExecution() end
        end)
        runScriptBtn.MouseButton1Click:Connect(function()
            nameInput.Text = data.name
            codeInput.Text = data.code
            local times = math.clamp(tonumber(repeatInput.Text) or 1, 1, 1000)
            local delay = math.max(tonumber(delayInput.Text) or 0, 0)
            if unitButton.Text == "Phút" then delay = delay * 60 end
            runCode(data.code, data.name, indicator, times, delay)
            statusLabel.Text = "⏳ Đang thực thi..."
        end)
        deleteBtn.MouseButton1Click:Connect(function()
            if currentScriptIndicator == indicator then cancelExecution() end
            table.remove(scripts, idx)
            rebuildScriptList()
        end)
    end
end

saveButton.MouseButton1Click:Connect(function()
    local name = nameInput.Text
    local code = codeInput.Text
    if #code == 0 then
        statusLabel.Text = "⚠️ Vui lòng nhập code!"
        return
    end
    if #name == 0 then name = "Script " .. (#scripts + 1) end
    
    local baseName = name
    local counter = 1
    while true do
        local exists = false
        for _, s in ipairs(scripts) do
            if s.name == name then exists = true; break end
        end
        if not exists then break end
        counter += 1
        name = baseName .. " (" .. counter .. ")"
    end
    
    table.insert(scripts, {name = name, code = code})
    rebuildScriptList()
    statusLabel.Text = "✅ Đã lưu: " .. name
    scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

